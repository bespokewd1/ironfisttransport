---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
	src: ImageMetadata;
	alt: string;
	label: string;
	caption: string;
	ratio?: "wide" | "portrait" | "landscape";
	position?: string;
	sizes?: string;
	eager?: boolean;
}

const {
	src, alt, label, caption,
	ratio = "wide",
	position = "center",
	sizes = "(min-width: 1440px) 1328px, (min-width: 768px) 92vw, calc(100vw - 48px)",
	eager = false,
} = Astro.props;
---

<figure class:list={["services-photo", `services-photo--${ratio}`]}>
	<div class="services-photo-frame">
		<Image src={src} alt={alt} width={1600} widths={[480, 768, 1024, 1440, 1600]} sizes={sizes} layout="full-width" loading={eager ? "eager" : "lazy"} fetchpriority={eager ? "high" : "auto"} style={`object-position: ${position}`} />
	</div>
	<figcaption><span>{label}</span><span>{caption}</span></figcaption>
</figure>

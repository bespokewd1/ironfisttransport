---
interface Props {
	current?: string;
}
const { current } = Astro.props;
---

<nav class="services-breadcrumbs" aria-label="Breadcrumb">
	<ol>
		<li><a href="/">Home</a></li>
		{current ? <><li><a href="/services/">Services</a></li><li aria-current="page">{current}</li></> : <li aria-current="page">Services</li>}
	</ol>
</nav>

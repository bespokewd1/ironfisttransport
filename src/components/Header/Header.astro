---
import { Image } from "astro:assets";
import { BUSINESS } from "@data/client";
import navData from "@data/navData.json";
import logo from "@assets/images/gallery/trucks/ironfist-logo.webp";
import HomeIcon from "@components/Home/HomeIcon.astro";

interface Props {
	quoteHref: string;
}
const { quoteHref } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isCurrent = (url: string) => pathname === (url.replace(/\/+$/, "") || "/");
const links = navData.map((entry) => ({
	...entry,
	current: isCurrent(entry.url) ? "page" as const
		: entry.children.some((child) => isCurrent(child.url)) ? "location" as const : undefined,
}));
---
<header class="home-header" data-site-header>
	<div class="home-wrap header-inner">
		<a href="/" class="brand" aria-label="Iron Fist Transport home">
			<Image src={logo} alt="Iron Fist" width={220} layout="fixed" loading="eager" />
			<span>Transport Ltd.</span>
		</a>
		<nav class="desktop-nav" aria-label="Main navigation">
			{links.map((entry, index) => entry.children.length ? (
				<div class="desktop-services" data-nav-group>
					<a href={entry.url} aria-current={entry.current}>{entry.key}</a>
					<details class="services-disclosure" data-nav-dropdown>
						<summary aria-label={`${entry.mobileKey ?? entry.key} links`} aria-controls={`desktop-navigation-${index}`}>
							<span class="services-chevron" aria-hidden="true"></span>
						</summary>
						<div class="services-panel" id={`desktop-navigation-${index}`} data-lenis-prevent>
							{entry.children.map((child) => <a href={child.url} aria-current={isCurrent(child.url) ? "page" : undefined}>{child.key}</a>)}
							<a class="all-services" href={entry.url} aria-current={entry.current}>{entry.overviewLabel ?? entry.key}<HomeIcon name="arrow" /></a>
						</div>
					</details>
				</div>
			) : <a href={entry.url} aria-current={entry.current}>{entry.key}</a>)}
		</nav>
		<div class="header-actions">
			<a class="header-phone" href={`tel:${BUSINESS.phoneForTel}`}>
				<HomeIcon name="phone" /><span>{BUSINESS.phoneFormatted}</span>
			</a>
			<a class="home-button header-quote" href={quoteHref}>Get a quote <HomeIcon name="arrow" /></a>
		</div>
		<details class="mobile-menu" data-site-menu>
			<summary aria-label="Main menu" aria-controls="site-mobile-navigation"><span class="menu-lines" aria-hidden="true"></span></summary>
			<nav id="site-mobile-navigation" aria-label="Mobile navigation" data-lenis-prevent>
				{links.map((entry, index) => entry.children.length ? (
					<details class="mobile-services" data-mobile-dropdown data-current={entry.current}>
						<summary aria-controls={`mobile-navigation-${index}`}>{entry.mobileKey ?? entry.key}<span class="services-chevron" aria-hidden="true"></span></summary>
						<div id={`mobile-navigation-${index}`}>
							{entry.children.map((child) => <a href={child.url} aria-current={isCurrent(child.url) ? "page" : undefined}>{child.key}<HomeIcon name="arrow" /></a>)}
							<a href={entry.url} aria-current={entry.current}>{entry.overviewLabel ?? entry.key}<HomeIcon name="arrow" /></a>
						</div>
					</details>
				) : <a href={entry.url} aria-current={entry.current}>{entry.key}<HomeIcon name="arrow" /></a>)}
				<a href={quoteHref}>Get a quote<HomeIcon name="arrow" /></a>
				<a class="mobile-phone" href={`tel:${BUSINESS.phoneForTel}`}><HomeIcon name="phone" />{BUSINESS.phoneFormatted}</a>
			</nav>
		</details>
	</div>
</header>

<script>
	let cleanup = () => {};

	document.addEventListener("astro:page-load", () => {
		cleanup();
		const header = document.querySelector<HTMLElement>("[data-site-header]");
		const menu = header?.querySelector<HTMLDetailsElement>("[data-site-menu]");
		if (!header || !menu) return;
		const controller = new AbortController();
		const options = { signal: controller.signal };
		const summary = menu.querySelector<HTMLElement>(":scope > summary");
		const groups = [...header.querySelectorAll<HTMLElement>("[data-nav-group]")];
		const mobileDropdowns = [...menu.querySelectorAll<HTMLDetailsElement>("[data-mobile-dropdown]")];
		const desktopDropdowns = [...header.querySelectorAll<HTMLDetailsElement>("[data-nav-dropdown]")];
		const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)");
		let restoringFocus = false;
		let pointerFocus = false;

		const closeDropdown = (dropdown: HTMLDetailsElement, restoreFocus = false) => {
			dropdown.open = false;
			if (restoreFocus) {
				restoringFocus = true;
				dropdown.querySelector<HTMLElement>(":scope > summary")?.focus();
				restoringFocus = false;
			}
		};
		const closeMenu = (restoreFocus = false) => {
			mobileDropdowns.forEach((dropdown) => closeDropdown(dropdown));
			menu.open = false;
			if (restoreFocus) summary?.focus();
		};
		const resetPointerFocus = () => { pointerFocus = false; };

		groups.forEach((group) => {
			const dropdown = group.querySelector<HTMLDetailsElement>("[data-nav-dropdown]")!;
			const openDropdown = () => {
				desktopDropdowns.filter((other) => other !== dropdown).forEach((other) => closeDropdown(other));
				dropdown.open = true;
			};
			group.addEventListener("pointerenter", (event) => {
				if (finePointer.matches && event.pointerType !== "touch") openDropdown();
			}, options);
			group.addEventListener("pointerleave", () => {
				if (!group.contains(document.activeElement)) closeDropdown(dropdown);
			}, options);
			group.addEventListener("pointerdown", () => { pointerFocus = true; }, options);
			group.addEventListener("focusin", () => {
				if (!pointerFocus && !restoringFocus) openDropdown();
			}, options);
			group.addEventListener("focusout", (event) => {
				if (event.relatedTarget) {
					if (!group.contains(event.relatedTarget as Node)) closeDropdown(dropdown);
				} else {
					queueMicrotask(() => {
						if (!group.contains(document.activeElement)) closeDropdown(dropdown);
					});
				}
			}, options);
		});
		document.addEventListener("click", resetPointerFocus, options);
		document.addEventListener("pointercancel", resetPointerFocus, options);
		header.addEventListener("click", (event) => {
			if ((event.target as Element).closest("a")) {
				desktopDropdowns.forEach((dropdown) => closeDropdown(dropdown));
				closeMenu();
			}
		}, options);
		menu.addEventListener("toggle", () => {
			if (!menu.open) mobileDropdowns.forEach((dropdown) => closeDropdown(dropdown));
		}, options);
		document.addEventListener("keydown", (event) => {
			resetPointerFocus();
			if (event.key !== "Escape") return;
			const mobileOpen = mobileDropdowns.filter((dropdown) => dropdown.open);
			const desktopOpen = desktopDropdowns.find((dropdown) => dropdown.open);
			if (menu.open && mobileOpen.length) {
				const focused = mobileOpen.find((dropdown) => dropdown.contains(document.activeElement)) ?? mobileOpen[0];
				mobileOpen.forEach((dropdown) => closeDropdown(dropdown, dropdown === focused));
			} else if (desktopOpen) closeDropdown(desktopOpen, true);
			else if (menu.open) closeMenu(true);
			else return;
			event.preventDefault();
			event.stopPropagation();
		}, options);
		document.addEventListener("pointerdown", (event) => {
			for (const group of groups) {
				if (!group.contains(event.target as Node)) closeDropdown(group.querySelector<HTMLDetailsElement>("[data-nav-dropdown]")!);
			}
			if (!menu.contains(event.target as Node)) closeMenu();
		}, options);
		menu.addEventListener("focusout", (event) => {
			if (event.relatedTarget) {
				if (!menu.contains(event.relatedTarget as Node)) closeMenu();
			} else {
				queueMicrotask(() => {
					if (!menu.contains(document.activeElement)) closeMenu();
				});
			}
		}, options);
		window.matchMedia("(min-width: 64rem)").addEventListener("change", () => {
			desktopDropdowns.forEach((dropdown) => closeDropdown(dropdown));
			closeMenu();
		}, options);
		cleanup = () => controller.abort();
	});
	document.addEventListener("astro:before-swap", () => cleanup());
</script>

<style lang="less">
	.home-header {
		position: sticky;
		top: 0;
		z-index: 100;
		border-bottom: 1px solid var(--home-line);
		background: #fff;
	}

	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		min-height: 5.25rem;
		position: relative;
	}

	.brand {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.125rem;
		width: 10.75rem;
		flex: none;
		color: var(--home-forest);
		text-decoration: none;

		img {
			width: 100%;
			height: auto;
		}

		span {
			font-size: 0.5rem;
			font-weight: 700;
			letter-spacing: 0.24em;
			text-transform: uppercase;
		}
	}

	.desktop-nav,
	.header-actions {
		display: flex;
		align-items: center;
		gap: 1.75rem;
	}

	.desktop-nav a {
		padding-block: 1rem;
		color: var(--headerColor);
		font-family: var(--home-mono);
		font-size: 0.6875rem;
		font-weight: 400;
		letter-spacing: 0.025em;
		text-transform: uppercase;
		text-decoration: none;

		&:hover {
			color: var(--home-green);
		}

		&[aria-current] {
			color: var(--home-green);
			text-decoration: underline;
			text-decoration-thickness: 1px;
			text-underline-offset: 0.35em;
		}
	}

	.desktop-services {
		display: flex;
		align-items: stretch;
		gap: 0.125rem;
	}

	.services-disclosure {
		position: relative;

		> summary {
			display: flex;
			align-items: center;
			justify-content: center;
			width: 2rem;
			min-height: 2.75rem;
			height: 100%;
			color: var(--home-forest);
			list-style: none;
			cursor: pointer;

			&::-webkit-details-marker {
				display: none;
			}

			&:hover {
				color: var(--home-green);
			}
		}
	}

	.services-chevron {
		width: 0.4375rem;
		height: 0.4375rem;
		flex: none;
		border-right: 1.5px solid currentColor;
		border-bottom: 1.5px solid currentColor;
		transform: translateY(-0.125rem) rotate(45deg);
	}

	.services-disclosure[open] > summary .services-chevron,
	.mobile-services[open] > summary .services-chevron {
		transform: translateY(0.125rem) rotate(225deg);
	}

	.services-panel {
		position: absolute;
		top: 100%;
		right: 0;
		width: 17rem;
		max-height: calc(100svh - 7rem);
		overflow-y: auto;
		overscroll-behavior: contain;
		padding: 0.5rem 1rem;
		border: 1px solid var(--home-line);
		background: #fff;
		box-shadow: 0 12px 24px #123b2a12;

		a {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 1rem;
			min-height: 2.75rem;
			padding-block: 0.75rem;
			color: var(--home-forest);
			line-height: 1.5;
		}

		.all-services {
			border-top: 1px solid var(--home-line);
		}

		svg {
			width: 1rem;
			height: 1rem;
		}
	}

	.services-disclosure:not([open]) > .services-panel,
	.mobile-services:not([open]) > div {
		display: none;
	}

	.desktop-nav a:focus-visible,
	.services-disclosure > summary:focus-visible,
	.mobile-menu > summary:focus-visible,
	.mobile-services > summary:focus-visible,
	.mobile-menu > nav a:focus-visible {
		outline: 2px solid var(--home-forest);
		outline-offset: 3px;
	}

	.header-phone {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		min-height: 2.75rem;
		color: var(--home-forest);
		font-family: var(--home-mono);
		font-size: 0.6875rem;
		font-weight: 400;
		letter-spacing: 0.025em;
		text-transform: uppercase;
		text-decoration: none;

		svg {
			width: 1rem;
			height: 1rem;
		}
	}

	.header-quote {
		min-height: 2.875rem;
		padding: 0.75rem 1rem;
		font-size: 0.8125rem;
	}

	.mobile-menu {
		display: none;

		> summary {
			display: flex;
			align-items: center;
			justify-content: center;
			width: 2.75rem;
			height: 2.75rem;
			border: 1px solid var(--home-line);
			border-radius: 0;
			list-style: none;
			cursor: pointer;

			&::-webkit-details-marker {
				display: none;
			}
		}

		> nav {
			position: absolute;
			top: 100%;
			left: 1.5rem;
			right: 1.5rem;
			max-height: calc(100svh - 9.75rem - env(safe-area-inset-bottom, 0px));
			overflow-y: auto;
			padding: 0.5rem 1.25rem;
			border: 1px solid var(--home-line);
			background: #fff;
			box-shadow: 0 12px 24px #123b2a12;

			a {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
				min-height: 3.5rem;
				border-bottom: 1px solid var(--home-line);
				color: var(--home-forest);
				font-size: 0.9375rem;
				font-weight: 500;
				text-decoration: none;

				&[aria-current] {
					color: var(--home-green);
					text-decoration: underline;
					text-decoration-thickness: 1px;
					text-underline-offset: 0.35em;
				}

				svg {
					width: 1.125rem;
					height: 1.125rem;
				}
			}

			.mobile-phone {
				justify-content: flex-start;
				border-bottom: 0;
			}
		}
	}

	.mobile-services {
		> summary {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 1rem;
			min-height: 3.5rem;
			border-bottom: 1px solid var(--home-line);
			color: var(--home-forest);
			font-size: 0.9375rem;
			font-weight: 500;
			list-style: none;
			cursor: pointer;

			&::-webkit-details-marker {
				display: none;
			}
		}

		&[data-current] > summary {
			color: var(--home-green);
		}

		> div {
			padding-left: 0.75rem;

			a {
				font-family: var(--home-mono);
				font-size: 0.75rem;
				font-weight: 400;
				letter-spacing: 0.025em;
				text-transform: uppercase;
			}
		}
	}

	.menu-lines {
		width: 1.125rem;
		height: 0.625rem;
		border-top: 2px solid var(--home-forest);
		border-bottom: 2px solid var(--home-forest);
	}

	@media (max-width: 63.99rem) {
		.desktop-nav,
		.header-quote {
			display: none;
		}

		.header-actions {
			margin-left: auto;
		}

		.mobile-menu {
			display: block;
		}
	}

	@media (max-width: 47.99rem) {
		.header-actions {
			display: none;
		}

		.header-inner {
			min-height: 4.5rem;
		}

		.brand {
			width: 9rem;
		}
	}
</style>

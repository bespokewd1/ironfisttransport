---
import { getImage } from "astro:assets";
import type { GetImageResult, ImageMetadata } from "astro";
import { BUSINESS, OG, SITE } from "@data/client";
import { getLocalBusinessSchema } from "@js/localBusinessSchema.js";

type HeroImage = GetImageResult | ImageMetadata;

interface Props {
	title?: string;
	description?: string;
	heroImage?: HeroImage;
}

const { title = SITE.title, description = SITE.description, heroImage } = Astro.props;

const productionOrigin = new URL(SITE.url).origin;
const localBusinessSchema = getLocalBusinessSchema(productionOrigin);
const canonical = new URL(Astro.url.pathname, productionOrigin).href;
const isBlogPage = /^\/blog(?:\/|$)/.test(Astro.url.pathname);
const pageTitle = `${title} | ${BUSINESS.name}`;
const ogType = "website";
const ogTitle = pageTitle;
const ogDescription = description;

let socialImage = new URL(OG.image, productionOrigin).href;
let socialImageWidth: number | undefined = OG.width;
let socialImageHeight: number | undefined = OG.height;
let socialImageType: string | undefined = OG.type;

if (heroImage) {
	// Both input types have src; only a GetImageResult has transform options.
	const social = "attributes" in heroImage || "options" in heroImage
		? heroImage
		: await getImage({
			src: heroImage,
			width: 1200,
			height: 630,
			fit: "cover",
			format: "jpeg",
		});

	socialImage = new URL(social.src, productionOrigin).href;
	socialImageWidth = Number(social.attributes.width ?? social.options.width) || undefined;
	socialImageHeight = Number(social.attributes.height ?? social.options.height) || undefined;
	const format = social.options.format;
	socialImageType = format
		? `image/${format === "jpg" ? "jpeg" : format === "svg" ? "svg+xml" : format}`
		: undefined;
}
---

<!-- LocalBusiness Schema (on ALL pages) - customize your JSON-LD structured data:
     https://developers.google.com/search/docs/advanced/structured-data/intro-structured-data  -->
<script is:inline type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />

<!-- Allow additional schemas from child layouts (e.g., BlogPosting for blog posts) -->
<slot name="schema" />

<!-- Page Title -->
<title>{pageTitle}</title>

<!-- Standard Meta Tags -->
<meta charset="utf-8" />
<meta name="description" content={description} />
{isBlogPage && <meta name="robots" content="noindex, follow" />}
<meta name="web_author" content={SITE.author} />
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, minimum-scale=1.0, viewport-fit=cover" />
<meta http-equiv="X-UA-Compatible" content="ie=edge" />
<link rel="canonical" href={canonical} />

<!-- Open Graph / Facebook -->
<meta property="og:locale" content={OG.locale} />
<meta property="og:url" content={canonical} />
<meta property="og:type" content={ogType} />
<meta property="og:title" content={ogTitle} />
<meta property="og:site_name" content={SITE.title} />
<meta property="og:description" content={ogDescription} />
<meta property="og:image" content={socialImage} />
{socialImageWidth && <meta property="og:image:width" content={socialImageWidth} />}
{socialImageHeight && <meta property="og:image:height" content={socialImageHeight} />}
{socialImageType && <meta property="og:image:type" content={socialImageType} />}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta property="twitter:domain" content={new URL(SITE.url).hostname} />
<meta property="twitter:url" content={canonical} />
<meta name="twitter:title" content={ogTitle} />
<meta name="twitter:description" content={ogDescription} />
<meta name="twitter:image" content={socialImage} />

<!-- Icons cropped from the supplied Iron Fist logo. -->
<link rel="apple-touch-icon" sizes="180x180" href="/assets/brand/apple-touch-icon.png" />
<link rel="icon" type="image/png" sizes="32x32" href="/assets/brand/favicon-32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/assets/brand/favicon-16.png" />
<link rel="manifest" href="/assets/brand/site.webmanifest" />
<meta name="msapplication-TileColor" content="#123b2a" />
<meta name="theme-color" content="#123b2a" />

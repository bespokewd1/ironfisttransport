---
import { Image } from "astro:assets";
import { BUSINESS } from "@data/client";
import logo from "@assets/images/gallery/trucks/ironfist-logo.webp";
import HomeIcon from "./HomeIcon.astro";
import SocialIcon from "./SocialIcon.astro";

interface Props {
	revealAfterHero?: boolean;
}

const { revealAfterHero = false } = Astro.props;
---

<footer class="home-footer">
	<div class="home-wrap">
		<div class="footer-invitation">
			<h2>Let's move your next load.</h2>
			<div class="footer-actions">
				<a class="footer-phone" href={`tel:${BUSINESS.phoneForTel}`}><HomeIcon name="phone" />{BUSINESS.phoneFormatted}</a>
				<a class="footer-quote" href="#quote">Request a quote<HomeIcon name="arrow" /></a>
			</div>
		</div>
		<div class="footer-top">
			<div class="footer-brand">
				<a href="/" aria-label="Iron Fist Transport home"><Image src={logo} alt="Iron Fist Transport" width={240} widths={[176, 240, 352, 480]} sizes="176px" layout="constrained" /></a>
				<p>Construction & industrial transportation.<br />Edmonton, Alberta.</p>
				<div class="social-links"><a href={BUSINESS.socials.facebook} target="_blank" rel="noopener noreferrer">Follow us on Facebook<SocialIcon name="facebook" /></a><a href={BUSINESS.socials.google} target="_blank" rel="noopener noreferrer">Find us on Google<SocialIcon name="google" /></a></div>
			</div>
			<div class="footer-column"><h3>Transport services</h3><a href="/services/moffett-delivery/">MOFFETT delivery</a><a href="/services/flatbed-transportation/">Flatbed transportation</a><a href="/services/power-only-trucking/">Power-only trucking</a><a href="#quote">Request a quote</a></div>
			<div class="footer-column footer-contact"><h3>Get in touch</h3><a href={`tel:${BUSINESS.phoneForTel}`}>{BUSINESS.phoneFormatted}</a><a href={`mailto:${BUSINESS.email}`}>{BUSINESS.email}</a><address>{BUSINESS.address.lineOne}<br />{BUSINESS.address.city}, {BUSINESS.address.state} {BUSINESS.address.zip}</address></div>
		</div>
		<div class="footer-bottom"><p>&copy; {new Date().getFullYear()} {BUSINESS.name}</p><a href="#main">Back to top<HomeIcon name="arrow" /></a></div>
	</div>
</footer>

<nav class="mobile-action-bar" aria-label="Quick contact" data-contact-actions data-reveal-after-hero={revealAfterHero ? "" : undefined} data-visible={revealAfterHero ? "false" : undefined} inert={revealAfterHero} aria-hidden={revealAfterHero ? "true" : undefined}>
	<a href={`tel:${BUSINESS.phoneForTel}`}><HomeIcon name="phone" />Call us</a>
	<a href="#quote"><span>Get a quote</span><HomeIcon name="arrow" /></a>
</nav>

<script src="../../js/contact-actions.ts"></script>

<style lang="less">
	.home-footer {
		padding-block: var(--home-section-space) 1.5rem;
		background: var(--home-forest);
		color: var(--home-paper);
	}

	.footer-invitation {
		padding-bottom: clamp(2.5rem, 5vw, 4.5rem);

		h2 {
			margin: 0;
			max-width: 55rem;
			color: #fff;
			font-size: clamp(2.25rem, 4vw, 3.5rem);
			font-weight: 500;
			line-height: 1.1;
			letter-spacing: -0.04em;
		}
	}

	.footer-actions {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 1rem 3rem;
		margin-top: 1.75rem;

		a {
			display: inline-flex;
			align-items: center;
			gap: 0.75rem;
			min-height: 2.75rem;
			color: #fff;
			text-decoration: underline;
			text-decoration-thickness: 1px;
			text-underline-offset: 0.25em;
		}

		svg {
			width: 1.125rem;
			height: 1.125rem;
			flex: none;
		}
	}

	.footer-phone {
		font-size: clamp(1.25rem, 2vw, 1.75rem);
		font-weight: 500;
	}

	.footer-quote {
		font-size: 1rem;
	}

	.footer-top {
		display: grid;
		grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1fr);
		gap: 3rem;
		padding-block: 2.5rem 3rem;
		border-top: 1px solid #ffffff30;
	}

	.footer-brand {
		> a {
			display: block;
			width: 11rem;
			max-width: 100%;
		}

		img {
			display: block;
			width: 100%;
			height: auto;
		}

		p {
			margin-top: 1.25rem;
			color: var(--home-line);
			font-size: 0.875rem;
			line-height: 1.75;
		}
	}

	.social-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.5rem;
		margin-top: 1rem;

		a {
			display: inline-flex;
			align-items: center;
			gap: 0.5rem;
			min-height: 2.75rem;
			color: var(--home-paper);
			font-size: 0.9375rem;
			text-decoration: underline;
			text-underline-offset: 0.25em;
		}

		svg {
			width: 1.25rem;
			height: 1.25rem;
			flex: none;
		}
	}

	.footer-column {
		display: flex;
		align-items: flex-start;
		flex-direction: column;

		h3 {
			margin: 0 0 1rem;
			color: var(--home-paper);
			font-family: var(--home-mono);
			font-size: 0.6875rem;
			font-weight: 400;
			letter-spacing: 0.07em;
			line-height: 1.5;
			text-transform: uppercase;
		}

		a {
			min-height: 2.75rem;
			padding-block: 0.5rem;
			color: var(--home-line);
			font-size: 0.875rem;
			line-height: 1.5;
			text-decoration: none;
			overflow-wrap: anywhere;

			&:hover {
				color: #fff;
				text-decoration: underline;
				text-underline-offset: 0.25em;
			}
		}

		address {
			margin-top: 0.75rem;
			color: var(--home-line);
			font-size: 0.875rem;
			font-style: normal;
			line-height: 1.75;
		}
	}

	.footer-contact > a:first-of-type {
		color: #fff;
		font-size: 1rem;
		font-weight: 500;
	}

	.footer-bottom {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-top: 1.25rem;
		border-top: 1px solid #ffffff30;

		p {
			margin: 0;
			color: var(--home-line);
			font-size: 0.75rem;
			line-height: 1.6;
		}

		a {
			display: inline-flex;
			align-items: center;
			gap: 0.5rem;
			min-height: 2.75rem;
			color: var(--home-paper);
			font-size: 0.75rem;
			text-decoration: underline;
			text-underline-offset: 0.25em;

			svg {
				width: 0.875rem;
				height: 0.875rem;
				transform: rotate(-90deg);
			}
		}
	}

	.mobile-action-bar {
		display: none;
		transition: transform 240ms cubic-bezier(0.16, 1, 0.3, 1), opacity 180ms ease-out, visibility 0ms;

		&[data-visible="false"] {
			transform: translateY(110%);
			opacity: 0;
			visibility: hidden;
			pointer-events: none;
			transition-delay: 0ms, 0ms, 240ms;
		}
	}

	@media (max-width: 47.99rem) {
		.footer-top {
			grid-template-columns: 1fr;
			gap: 2rem;
			padding-bottom: 2rem;
		}

		.footer-bottom {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.25rem;
		}
	}

	@media (max-width: 63.99rem) {
		.mobile-action-bar {
			position: fixed;
			z-index: 90;
			bottom: 0;
			left: 0;
			right: 0;
			display: grid;
			grid-template-columns: 1fr 1.25fr;
			box-sizing: border-box;
			height: calc(4.25rem + env(safe-area-inset-bottom, 0px));
			padding: 0.625rem 1rem calc(0.625rem + env(safe-area-inset-bottom, 0px));
			gap: 0.75rem;
			border-top: 1px solid var(--home-line);
			background: var(--home-paper);

			a {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 0.75rem;
				min-height: 0;
				box-sizing: border-box;
				border: 1px solid var(--home-line);
				border-radius: 0;
				color: var(--home-forest);
				font-size: 0.9375rem;
				font-weight: 500;
				text-decoration: none;

				+ a {
					border-color: var(--home-green);
					background: var(--home-green);
					color: #fff;
				}
			}

			svg {
				width: 1.125rem;
				height: 1.125rem;
			}
		}
	}

	@media (min-width: 48rem) and (max-width: 63.99rem) {
		.mobile-action-bar:not([data-reveal-after-hero]) {
			display: none;
		}
	}
</style>

---
import { GOOGLE_REVIEWS_URL, REVIEWS } from "@data/reviews";
import HomeIcon from "./HomeIcon.astro";
import SocialIcon from "./SocialIcon.astro";
---

<section class="home-reviews" aria-labelledby="reviews-title">
	<div class="home-wrap reviews-layout">
		<div class="reviews-intro">
			<h2 id="reviews-title">What Our Customers Say</h2>
			<a class="home-link" href={GOOGLE_REVIEWS_URL} target="_blank" rel="noopener noreferrer">Read Our Google Reviews<HomeIcon name="external" /><span class="reviews-sr-only">, opens in a new tab</span></a>
		</div>
		<home-reviews role="group" aria-roledescription="carousel" aria-label="Customer reviews">
			<div class="reviews-slides" id="home-review-slides">
				{REVIEWS.map((review, index) => (
					<figure class="review" role="group" aria-roledescription="slide" aria-label={`${index + 1} of ${REVIEWS.length}`}>
						<div class="review-source">
							<span class="review-stars" role="img" aria-label={`${review.rating} out of 5 stars`}>
								{Array.from({ length: review.rating }, () => <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01Z" /></svg>)}
							</span>
							<span class="review-google"><SocialIcon name="google" />Google</span>
						</div>
						<blockquote><p>{review.text}</p></blockquote>
						<figcaption>{review.author}</figcaption>
					</figure>
				))}
			</div>
			<p class="reviews-sr-only" role="status" aria-atomic="true"></p>
			<div class="reviews-controls" hidden>
				<span class="review-position" aria-hidden="true">1 of {REVIEWS.length}</span>
				<button type="button" data-direction="-1" aria-label="Previous review" aria-controls="home-review-slides"><HomeIcon name="arrow" /></button>
				<button type="button" data-direction="1" aria-label="Next review" aria-controls="home-review-slides"><HomeIcon name="arrow" /></button>
			</div>
		</home-reviews>
	</div>
</section>

<script>
	class HomeReviews extends HTMLElement {
		private controller?: AbortController;

		connectedCallback() {
			this.controller?.abort();
			this.controller = new AbortController();
			const slides = Array.from(this.querySelectorAll<HTMLElement>(".review"));
			const controls = this.querySelector<HTMLElement>(".reviews-controls")!;
			const position = this.querySelector<HTMLElement>(".review-position")!;
			const status = this.querySelector<HTMLElement>('[role="status"]')!;
			let current = 0;
			const show = (index: number) => {
				current = (index + slides.length) % slides.length;
				slides.forEach((slide, i) => {
					const active = i === current;
					slide.setAttribute("aria-hidden", String(!active));
					slide.inert = !active;
				});
				position.textContent = `${current + 1} of ${slides.length}`;
			};
			show(0);
			this.dataset.enhanced = "";
			controls.hidden = slides.length < 2;
			this.querySelectorAll<HTMLButtonElement>("button[data-direction]").forEach((button) => {
				button.addEventListener("click", () => {
					slides.forEach((slide) => slide.getAnimations().forEach((animation) => animation.cancel()));
					show(current + Number(button.dataset.direction));
					const active = slides[current];
					status.textContent = `Review ${current + 1} of ${slides.length}. ${active.querySelector("figcaption")!.textContent}. ${active.querySelector(".review-stars")!.getAttribute("aria-label")}. ${active.querySelector("blockquote")!.textContent}`;
					if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
						slides[current].animate(
							[{ opacity: 0, transform: "translateY(6px)" }, { opacity: 1, transform: "translateY(0)" }],
							{ duration: 220, easing: "cubic-bezier(0.16, 1, 0.3, 1)" },
						);
					}
				}, { signal: this.controller!.signal });
			});
		}

		disconnectedCallback() {
			this.controller?.abort();
		}
	}

	if (!customElements.get("home-reviews")) customElements.define("home-reviews", HomeReviews);
</script>

<style lang="less">
	.home-reviews {
		padding-block: clamp(2rem, 4vw, 3.5rem);
		border-bottom: 1px solid var(--home-line);
		background: #fff;
		color: var(--home-ink);
	}

	.reviews-layout {
		display: grid;
		grid-template-columns: 0.8fr 1.2fr;
		gap: clamp(2rem, 5vw, 5rem);
		align-items: start;
	}

	.reviews-intro h2 {
		max-width: 14ch;
		margin-bottom: 0.75rem;
		font-size: clamp(1.75rem, 2.7vw, 2.5rem);
		font-weight: 500;
		line-height: 1.12;
		letter-spacing: -0.03em;
		text-wrap: balance;
	}

	home-reviews { display: block; min-width: 0; }
	.review { margin: 0; }
	.review + .review { margin-top: 2rem; }
	.review-source { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
	.review-stars { display: inline-flex; gap: 0.125rem; color: #b17b08; }
	.review-google { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--home-muted); font-size: 0.8125rem; }
	.review-google :global(svg) { width: 1.25rem; height: 1.25rem; }
	.review blockquote { margin: 0 0 1rem; padding: 0; border: 0; }
	.review blockquote p { color: var(--home-ink); font-size: clamp(1.125rem, 1.6vw, 1.375rem); font-weight: 400; line-height: 1.55; }
	.review figcaption { color: var(--home-muted); font-size: 0.875rem; line-height: 1.5; }

	home-reviews[data-enhanced] {
		.reviews-slides { display: grid; }
		.review { grid-area: 1 / 1; margin: 0; }
		.review[aria-hidden="true"] { visibility: hidden; }
	}

	.reviews-controls:not([hidden]) { display: flex; align-items: center; justify-content: flex-end; gap: 0.5rem; margin-top: 1rem; }
	.review-position { margin-right: 0.5rem; color: var(--home-muted); font-size: 0.8125rem; font-variant-numeric: tabular-nums; }
	.reviews-controls button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		padding: 0;
		border: 1px solid var(--home-line);
		border-radius: 0;
		background: #fff;
		color: var(--home-forest);
		cursor: pointer;
		transition: background-color 150ms;
		&:hover { background: var(--home-paper); }
		:global(svg) { width: 1.125rem; height: 1.125rem; }
		&[data-direction="-1"] :global(svg) { transform: rotate(180deg); }
	}

	.reviews-sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }

	@media (max-width: 47.99rem) {
		.reviews-layout { grid-template-columns: 1fr; gap: 1.25rem; }
		.reviews-intro h2 { max-width: none; }
		.review-source { margin-bottom: 0.75rem; }
	}
</style>

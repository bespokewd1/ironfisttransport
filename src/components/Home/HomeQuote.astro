---
import { BUSINESS } from "@data/client";
import HomeIcon from "./HomeIcon.astro";

interface Props {
	defaultService?: "" | "MOFFETT delivery" | "Flatbed transportation" | "Power-only trucking";
	checklist?: string[];
}

const {
	defaultService = "",
	checklist = [
		"Approximate weight and dimensions",
		"Whether you need forklift offloading",
		"Site access and ground conditions",
	],
} = Astro.props;
const formName = "transport-quote";
---

<section id="quote" class="home-section" aria-labelledby="quote-title">
	<div class="home-wrap">
		<div class="quote-heading">
			<h2 id="quote-title" class="home-title">Call us or<br />request a quote.</h2>
			<p>Talk through your delivery by phone, or fill in the form with your pickup, destination and load details.</p>
		</div>
		<div class="quote-grid">
			<aside class="quote-copy" aria-labelledby="quote-call-title">
				<div class="quote-contact">
					<h3 id="quote-call-title">Call us</h3>
					<p>Speak directly with {BUSINESS.owner} about your load, route and offloading.</p>
					<a class="quote-phone" href={`tel:${BUSINESS.phoneForTel}`} aria-label={`Call Iron Fist Transport at ${BUSINESS.phoneFormatted}`}><HomeIcon name="phone" />{BUSINESS.phoneFormatted}</a>
					<a class="quote-email" href={`mailto:${BUSINESS.email}`}>{BUSINESS.email}<HomeIcon name="mail" /></a>
				</div>
			</aside>
			<div class="quote-panel">
				<div class="form-heading"><h3>Request a quote</h3><p>Send your pickup, destination and load details. We'll contact you to discuss the move.</p></div>
				<form class="quote-form" name={formName} method="POST" enctype="application/x-www-form-urlencoded" data-netlify="true" netlify-honeypot="bot-field" data-quote-form data-astro-reload aria-label="Transport quote request">
					<input type="hidden" name="form-name" value={formName} />
					<input type="hidden" name="source-page" value={Astro.url.pathname} />
					<div hidden><label>Leave this field empty<input name="bot-field" tabindex="-1" autocomplete="off" /></label></div>
					<div class="field"><label for="quote-name">Your name <span aria-hidden="true">*</span></label><input id="quote-name" name="name" autocomplete="name" maxlength="80" required /></div>
					<div class="field"><label for="quote-contact">Phone or email <span aria-hidden="true">*</span></label><input id="quote-contact" name="contact" maxlength="120" aria-describedby="contact-help" required /><span id="contact-help" class="field-help">How should we get back to you?</span></div>
					<div class="field"><label for="quote-pickup">Pickup city or postal code <span aria-hidden="true">*</span></label><input id="quote-pickup" name="pickup" maxlength="120" required /></div>
					<div class="field"><label for="quote-delivery">Delivery city or postal code <span aria-hidden="true">*</span></label><input id="quote-delivery" name="delivery" maxlength="120" required /></div>
					<div class="field"><label for="quote-service">Service <span class="optional">optional</span></label><select id="quote-service" name="service"><option value="" selected={defaultService === ""}>Not sure yet</option><option selected={defaultService === "MOFFETT delivery"}>MOFFETT delivery</option><option selected={defaultService === "Flatbed transportation"}>Flatbed transportation</option><option selected={defaultService === "Power-only trucking"}>Power-only trucking</option></select></div>
					<div class="field"><label for="quote-date">Preferred date <span class="optional">optional</span></label><input id="quote-date" name="date" type="date" /></div>
					<div class="field field-wide"><label for="quote-load">What are you moving? <span aria-hidden="true">*</span></label><textarea id="quote-load" name="load" rows="4" maxlength="1500" placeholder="Materials, quantity, weight, dimensions and any offloading or access details" required></textarea></div>
					<div class="form-actions field-wide"><button class="home-button" type="submit"><span data-submit-label>Send quote request</span><HomeIcon name="arrow" /></button><span>Fields marked * are required.</span></div>
				</form>
				<p class="quote-status" data-quote-status role="status" aria-live="polite" aria-atomic="true" tabindex="-1" hidden></p>
				<p class="quote-note">Your requested date is not a confirmed booking.</p>
			</div>
			<div class="quote-checklist">
				<h3>Helpful delivery details</h3>
				<ul>
					{checklist.map((item) => <li>{item}</li>)}
				</ul>
			</div>
		</div>
	</div>
</section>

<script>
	let cleanup = () => {};

	document.addEventListener("astro:page-load", () => {
		cleanup();
		const form = document.querySelector<HTMLFormElement>("[data-quote-form]");
		const status = document.querySelector<HTMLElement>("[data-quote-status]");
		const submit = form?.querySelector<HTMLButtonElement>("button[type='submit']");
		const submitLabel = submit?.querySelector<HTMLElement>("[data-submit-label]");
		if (!form || !status || !submit || !submitLabel) return;

		const controller = new AbortController();
		const options = { signal: controller.signal };

		form.addEventListener("input", (event) => {
			const field = event.target;
			if (field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement) field.setCustomValidity("");
		}, options);

		form.addEventListener("submit", async (event) => {
			event.preventDefault();
			if (submit.disabled) return;

			for (const name of ["name", "contact", "pickup", "delivery", "load"]) {
				const field = form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement;
				field.setCustomValidity(field.value.trim() ? "" : "Please fill out this field.");
			}

			const contact = form.elements.namedItem("contact") as HTMLInputElement;
			const value = contact.value.trim();
			const isEmail = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);
			const digits = value.replace(/\D/g, "");
			const isPhone = /^[+\d\s().-]+$/.test(value) && digits.length >= 7 && digits.length <= 15;
			contact.setCustomValidity(isEmail || isPhone ? "" : "Enter a valid email address or phone number.");
			if (!form.reportValidity()) return;

			const body = new URLSearchParams();
			new FormData(form).forEach((value, name) => body.append(name, String(value)));
			submit.disabled = true;
			submitLabel.textContent = "Sending...";
			form.setAttribute("aria-busy", "true");
			status.hidden = false;
			status.dataset.state = "pending";
			status.textContent = "Sending your quote request...";

			try {
				const response = await fetch("/", {
					method: "POST",
					headers: { "Content-Type": "application/x-www-form-urlencoded" },
					body: body.toString(),
					signal: controller.signal,
				});
				if (!response.ok) throw new Error("Quote submission failed");

				form.hidden = true;
				status.dataset.state = "success";
				status.textContent = "Thank you. Your quote request has been sent. We'll contact you to discuss the move. Your requested date is not a confirmed booking.";
				status.focus({ preventScroll: true });
			} catch {
				if (controller.signal.aborted) return;
				status.dataset.state = "error";
				status.textContent = "We couldn't confirm your request was sent. Your details are still here. Please try again, or call or email us directly.";
				status.focus({ preventScroll: true });
			} finally {
				submit.disabled = false;
				submitLabel.textContent = "Send quote request";
				form.removeAttribute("aria-busy");
			}
		}, options);

		cleanup = () => controller.abort();
	});

	document.addEventListener("astro:before-swap", () => cleanup());
</script>

<style lang="less">
	.quote-heading {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 2rem;
		margin-bottom: clamp(2.5rem, 4vw, 3.5rem);

		h2 { letter-spacing: -0.04em; }
		> p {
			max-width: 29rem;
			font-size: 1rem;
			line-height: 1.75;
		}
	}

	.quote-grid {
		display: grid;
		grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
		grid-template-areas: "call form" "details form";
		grid-template-rows: auto 1fr;
		align-items: start;
		gap: 2rem clamp(2.5rem, 5vw, 5rem);
	}

	.quote-copy {
		grid-area: call;
		min-width: 0;
	}

	.quote-contact {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		padding: clamp(1.5rem, 3vw, 2.5rem);
		background: var(--home-forest);
		color: var(--home-paper);

		h3 {
			margin: 0 0 0.75rem;
			color: #fff;
			font-size: 1.5rem;
			font-weight: 500;
		}

		> p {
			color: var(--home-paper);
			font-size: 1rem;
			line-height: 1.75;
		}
	}

	.quote-phone {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		min-height: 3rem;
		margin-top: 1.5rem;
		color: #fff;
		font-size: clamp(1.125rem, 2.2vw, 1.875rem);
		font-weight: 500;
		text-decoration: none;
		white-space: nowrap;
		font-variant-numeric: tabular-nums;

		&:hover { text-decoration: underline; text-underline-offset: 0.2em; }

		svg {
			width: 1.375rem;
			height: 1.375rem;
			flex: none;
		}
	}

	.quote-email {
		display: inline-flex;
		align-items: center;
		gap: 0.625rem;
		min-height: 2.75rem;
		margin-top: 0.25rem;
		max-width: 100%;
		color: var(--home-paper);
		font-size: 0.9375rem;
		text-underline-offset: 0.3em;
		overflow-wrap: anywhere;
		svg { width: 1rem; height: 1rem; flex: none; }
	}

	.quote-checklist {
		grid-area: details;
		min-width: 0;

		h3 {
			margin-bottom: 1rem;
			font-size: 1rem;
		}

		ul {
			display: grid;
			padding: 0;
			list-style: none;
		}

		li {
			padding-block: 0.875rem;
			border-bottom: 1px solid var(--home-line);
			color: var(--home-muted);
			font-size: 0.9375rem;
			line-height: 1.6;
		}
	}

	.quote-panel {
		grid-area: form;
		min-width: 0;
		padding-top: 1.5rem;
		border-top: 1px solid var(--home-line);
	}

	.form-heading {
		margin-bottom: 2rem;

		h3 {
			margin-bottom: 0.75rem;
			font-size: 1.5rem;
			font-weight: 500;
		}

		p {
			font-size: 0.9375rem;
			line-height: 1.7;
		}
	}

	.quote-form {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.25rem 1rem;
	}

	.quote-form[hidden],
	.quote-status[hidden] {
		display: none;
	}

	.field {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		min-width: 0;
	}

	.field-wide {
		grid-column: 1 / -1;
	}

	label {
		display: block;
		color: var(--home-ink);
		font-family: var(--home-mono);
		font-size: 0.875rem;
		font-weight: 400;
		line-height: 1.5;

		span:not(.optional) {
			color: var(--home-green);
		}
	}

	.optional {
		margin-left: 0.25rem;
		color: var(--home-muted);
		font-size: 0.8125rem;
		font-weight: 400;
	}

	input,
	select,
	textarea {
		width: 100%;
		min-width: 0;
		min-height: 3.25rem;
		padding: 0.875rem 0.75rem;
		border: 0;
		border-bottom: 1px solid #869b83;
		border-radius: 0;
		background: #f3f6ef;
		color: var(--headerColor);
		font-size: 1rem;
		line-height: 1.5;
		caret-color: var(--home-green);
	}

	textarea {
		resize: vertical;
	}

	textarea::placeholder {
		color: var(--home-muted);
		font-size: 0.9375rem;
	}

	.field-help {
		color: var(--home-muted);
		font-size: 0.8125rem;
	}

	.form-actions {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.75rem 1rem;
		margin-top: 0.25rem;

		.home-button {
			font-size: 1rem;

			&:disabled {
				opacity: 0.7;
				cursor: wait;
			}
		}

		> span {
			color: var(--home-muted);
			font-size: 0.8125rem;
			line-height: 1.7;
		}
	}

	.quote-status {
		margin-top: 1.5rem;
		padding: 1rem;
		border: 1px solid var(--home-line);
		color: var(--home-forest);
		font-size: 0.9375rem;
		line-height: 1.7;

		&[data-state="success"] {
			background: #f3f6ef;
		}

		&[data-state="error"] {
			border-color: #9c3025;
			color: #84281f;
		}
	}

	.quote-note {
		margin-top: 1.5rem;
		font-size: 0.875rem;
		line-height: 1.6;
	}

	@media (max-width: 47.99rem) {
		.quote-heading {
			align-items: flex-start;
			flex-direction: column;
			gap: 1.25rem;
		}

		.quote-grid {
			grid-template-columns: 1fr;
			grid-template-areas: "call" "form" "details";
			grid-template-rows: auto;
		}

		.quote-phone {
			font-size: clamp(1.375rem, 5.5vw, 1.875rem);
		}
	}

	@media (max-width: 35.99rem) {
		.quote-form {
			grid-template-columns: 1fr;
		}
	}
</style>

---
import { Image } from "astro:assets";
import photo from "@assets/images/gallery/trucks/moffeti.webp";
import HomeIcon from "./HomeIcon.astro";
---

<section id="moffett" class="home-section moffett-section" aria-labelledby="moffett-title">
	<div class="home-wrap moffett-grid">
		<div class="moffett-copy">
			<p class="home-eyebrow">The MOFFETT difference</p>
			<h2 id="moffett-title" class="home-title">No forklift on site?<br />We bring one.</h2>
			<p class="moffett-intro">A MOFFETT is a forklift that travels on the back of the truck. When we arrive, it comes off the trailer to unload suitable materials at your site.</p>
			<ul class="moffett-benefits">
				<li><h3>Delivery and offloading together</h3><p>You don't need to arrange a separate forklift for loads we can handle with our truck-mounted equipment.</p></li>
				<li><h3>Plan the drop before we arrive</h3><p>Tell us about access and where the materials need to go. We'll discuss placement and equipment suitability before the delivery.</p></li>
			</ul>
			<p class="access-note">Gates, ground conditions and load dimensions matter. Include them in your quote request so we can plan the offload.</p>
			<a class="home-link" href="#quote">Plan a MOFFETT delivery<HomeIcon name="arrow" /></a>
		</div>
		<figure class="moffett-photo">
			<div class="moffett-photo-frame"><Image src={photo} alt="MOFFETT forklift beside a loaded flatbed trailer at an industrial site" width={800} widths={[400, 600, 800, 1200]} sizes="(min-width: 1440px) 480px, (min-width: 768px) 36vw, calc(100vw - 48px)" layout="full-width" /></div>
			<figcaption><span>Truck-mounted MOFFETT</span><span>Forklift offloading. Delivered with the truck.</span></figcaption>
		</figure>
	</div>
</section>

<style lang="less">
	.moffett-section {
		background: var(--home-forest);
		color: var(--home-paper);

		.home-eyebrow {
			color: var(--home-line);
		}

		.home-title {
			color: #fff;
		}

		.home-link {
			min-height: 2.75rem;
			color: #fff;
		}
	}

	.moffett-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
		align-items: center;
		gap: clamp(2.5rem, 5vw, 5rem);
	}

	.moffett-copy {
		min-width: 0;
		max-width: 40rem;
	}

	.moffett-intro {
		margin-block: 1.5rem 2rem;
		color: var(--home-paper);
		font-size: 1rem;
		line-height: 1.75;
		max-width: 35rem;
	}

	.moffett-benefits {
		margin: 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid #ffffff30;

		li {
			padding-block: 1.125rem;
			border-bottom: 1px solid #ffffff30;
		}

		h3 {
			margin: 0 0 0.5rem;
			color: #fff;
			font-size: 1rem;
			font-weight: 500;
			line-height: 1.4;
		}

		p {
			margin: 0;
			color: var(--home-line);
			font-size: 0.875rem;
			line-height: 1.7;
			max-width: 34rem;
		}
	}

	.access-note {
		margin-block: 1.25rem 1rem;
		max-width: 34rem;
		color: var(--home-line);
		font-size: 0.8125rem;
		line-height: 1.7;
	}

	.moffett-photo {
		margin: 0;
		min-width: 0;

		figcaption {
			display: flex;
			flex-direction: column;
			gap: 0.375rem;
			padding-top: 1rem;
			color: var(--home-line);
			font-size: 0.75rem;
			line-height: 1.5;

			span:first-child {
				color: var(--home-paper);
				font-family: var(--home-mono);
				font-size: 0.6875rem;
				letter-spacing: 0.06em;
				text-transform: uppercase;
			}
		}
	}

	.moffett-photo-frame {
		aspect-ratio: 0.74;
		overflow: hidden;

		img {
			display: block;
			width: 100%;
			height: 100%;
			object-fit: cover;
			object-position: center 70%;
		}
	}

	@media (max-width: 47.99rem) {
		.moffett-grid {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}

		.moffett-photo-frame {
			aspect-ratio: 0.85;
		}
	}
</style>

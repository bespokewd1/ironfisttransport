---
import { Image } from "astro:assets";
import { industries } from "@data/industries";
import HomeIcon from "./HomeIcon.astro";
---

<section class="home-section home-industries" aria-labelledby="industries-title">
	<div class="home-wrap">
		<div class="industries-heading"><h2 id="industries-title" class="home-title">Industries we serve.</h2><a class="home-link" href="/industries/">View Industries<HomeIcon name="arrow" /></a></div>
		<div class="industries-preview">
			{industries.map((industry) => <article>
				<a class="industry-link" href={`/industries/#${industry.id}`} aria-labelledby={`home-${industry.id}-title`}>
					<div class="industry-photo"><Image src={industry.image} alt={industry.alt} width={640} widths={[320, 480, 640, 960]} sizes="(min-width: 1440px) 421px, (min-width: 768px) 29vw, calc(100vw - 48px)" loading="lazy" style={`object-position: ${industry.position}`} /></div>
					<h3 id={`home-${industry.id}-title`}><span>{industry.title}</span><HomeIcon name="arrow" /></h3>
					<p>{industry.summary}</p>
				</a>
			</article>)}
		</div>
	</div>
</section>

<style lang="less">
	.home-industries { padding-block: clamp(3rem, 5vw, 4.5rem); background: var(--home-paper); }
	.industries-heading { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 1rem 2rem; margin-bottom: 2rem; }
	.industries-heading .home-title { font-size: clamp(2rem, 3.5vw, 3.25rem); }
	.industries-preview { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.75rem 2rem; }
	.industries-preview article, .industry-link { display: grid; grid-template-rows: subgrid; grid-row: span 3; min-width: 0; }
	.industry-link { color: var(--home-ink); text-decoration: none; }
	.industry-link:hover h3, .industry-link:focus-visible h3 { color: var(--home-forest); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
	.industry-link:focus-visible { outline: 2px solid var(--home-forest); outline-offset: 6px; }
	.industry-photo { display: block; aspect-ratio: 1.9; overflow: hidden; }
	.industry-photo img { display: block; width: 100%; height: 100%; object-fit: cover; }
	.industries-preview h3 { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin: 0.5rem 0 0; padding-top: 1rem; border-top: 1px solid var(--home-line); font-size: clamp(1.25rem, 1.7vw, 1.5rem); font-weight: 500; line-height: 1.25; letter-spacing: -0.025em; }
	.industries-preview h3 svg { width: 1.25rem; height: 1.25rem; flex: none; align-self: start; margin-top: 0.15rem; }
	.industries-preview p { margin: 0; max-width: 40ch; color: var(--home-muted); font-size: 0.875rem; line-height: 1.75; }
	@media (max-width: 47.99rem) { .industries-preview { grid-template-columns: 1fr; } .industries-preview article:not(:last-child) { margin-bottom: 1.25rem; } .industry-photo { aspect-ratio: 2.2; } }
</style>

---
import { BUSINESS } from "@data/client";
import HomeIcon from "./HomeIcon.astro";
import SocialIcon from "./SocialIcon.astro";
---

<section id="about" class="home-section about-section" aria-labelledby="about-title">
	<div class="home-wrap about-grid">
		<div class="about-copy">
			<p class="home-eyebrow">Local business. Direct contact.</p>
			<h2 id="about-title" class="home-title">Talk to the person<br />moving your load.</h2>
			<p>Iron Fist Transport is an owner-operated business based in Edmonton. {BUSINESS.owner} handles the driving and deliveries, so you can discuss your load with the person doing the work.</p>
			<p>Have questions about pickup, site access or offloading? Call us before you book. We'll work through the details with you.</p>
			<a class="home-link" href={`tel:${BUSINESS.phoneForTel}`}><HomeIcon name="phone" />Talk about your delivery</a>
			<a class="google-link" href={BUSINESS.socials.google} target="_blank" rel="noopener noreferrer">Find us on Google<SocialIcon name="google" /></a>
		</div>
		<aside class="about-rail" aria-label="Business details and route availability">
			<div class="rail-base">
				<p class="rail-label">Base</p>
				<h3>Edmonton,<br />Alberta</h3>
				<p class="coverage-intro">Moving a load beyond Edmonton?</p>
				<p>Share your pickup and delivery locations. We'll confirm route availability and whether our equipment is the right fit for your load.</p>
				<a class="home-link" href="#quote">Let's plan the route<HomeIcon name="arrow" /></a>
			</div>
			<div class="rail-fact"><p class="rail-label">Owner-operated</p><p>{BUSINESS.owner}</p></div>
			<div class="rail-fact"><p class="rail-label">Contact</p><a href={`tel:${BUSINESS.phoneForTel}`}>{BUSINESS.phoneFormatted}</a></div>
		</aside>
	</div>
</section>

<style lang="less">
	.about-section {
		background: #fff;
	}

	.about-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
		align-items: start;
		gap: clamp(2.5rem, 7vw, 7rem);
	}

	.about-copy {
		min-width: 0;

		> p:not(.home-eyebrow) {
			max-width: 35rem;
			margin-top: 1.5rem;
			color: var(--home-muted);
			font-size: 1rem;
			line-height: 1.75;
		}

		.home-link {
			min-height: 2.75rem;
			margin-top: 1.25rem;
		}
	}

	.google-link {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		width: fit-content;
		min-height: 2.75rem;
		color: var(--home-muted);
		font-size: 0.9375rem;
		text-decoration: underline;
		text-underline-offset: 0.25em;

		svg {
			width: 1.25rem;
			height: 1.25rem;
			flex: none;
		}
	}

	.about-rail {
		min-width: 0;
		border-top: 1px solid var(--home-line);
		color: var(--home-ink);

		.rail-label {
			margin: 0;
			color: var(--home-muted);
			font-family: var(--home-mono);
			font-size: 0.6875rem;
			font-weight: 400;
			letter-spacing: 0.08em;
			line-height: 1.5;
			text-transform: uppercase;
		}
	}

	.rail-base {
		padding-block: 1.25rem 1.5rem;

		h3 {
			margin-block: 1.25rem 1.5rem;
			color: var(--home-ink);
			font-size: clamp(2.75rem, 4.5vw, 4rem);
			font-weight: 500;
			line-height: 1.05;
			letter-spacing: -0.045em;
		}

		> p:not(.rail-label) {
			margin: 0;
			color: var(--home-muted);
			font-size: 0.875rem;
			line-height: 1.75;
		}

		> .coverage-intro {
			margin-bottom: 0.5rem;
			color: var(--home-ink);
			font-weight: 500;
		}

		.home-link {
			min-height: 2.75rem;
			margin-top: 0.5rem;
			font-size: 0.875rem;
		}
	}

	.rail-fact {
		display: grid;
		grid-template-columns: 1fr 1.15fr;
		align-items: baseline;
		gap: 1rem;
		padding-block: 1.25rem;
		border-top: 1px solid var(--home-line);

		> p:not(.rail-label),
		a {
			margin: 0;
			color: var(--home-ink);
			font-size: 0.9375rem;
			line-height: 1.5;
		}

		a {
			text-decoration: underline;
			text-underline-offset: 0.25em;
		}

		&:last-child {
			border-bottom: 1px solid var(--home-line);
		}
	}

	@media (max-width: 47.99rem) {
		.about-grid {
			grid-template-columns: 1fr;
		}
	}
</style>

	</>}
	{name === "flatbed" && <>
		<path d="M4 14h56v7H4zM9 21v4m47-4v9h5M31 21h9" />
		<circle cx="16" cy="26" r="4" /><circle cx="27" cy="26" r="4" /><circle cx="46" cy="26" r="4" />
	</>}
	{name === "tractor" && <>
		<path d="M5 28V20h9l5-10h8V5h13v23M19 10h8v10H14M5 28h4m8 0h22m1-7h20v7h-2M45 17h13M47 28h3M8 23h4M32 10v10" />

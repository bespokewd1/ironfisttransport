---
import { Image } from "astro:assets";
import truck from "@assets/images/gallery/trucks/tractor.webp";
import winterTruck from "@assets/images/gallery/trucks/truck-in-snow.jpg";
import HomeIcon from "./HomeIcon.astro";

const materials = [
	{ title: "Building materials", detail: "Roofing, insulation & site supplies" },
	{ title: "Lumber", detail: "Lumber & packaged wood products" },
	{ title: "Steel", detail: "Pipe, steel & crated industrial freight" },
	{ title: "Palletized", detail: "Packaged materials ready to offload" },
];
---

<section id="work" class="home-section work-section" aria-labelledby="work-title">
	<div class="home-wrap">
		<div class="work-heading">
			<div><p class="home-eyebrow">Our equipment at work</p><h2 id="work-title" class="home-title">A closer look<br />at the work.</h2></div>
			<p>A look at the truck, trailer and forklift we use to move construction materials and industrial loads.</p>
		</div>
		<div class="work-grid">
			<figure class="work-primary">
				<div class="work-photo truck-photo"><Image src={truck} alt="Branded Iron Fist Transport tractor hauling crated materials on a flatbed trailer" width={1000} widths={[480, 768, 1000, 1400]} sizes="(min-width: 1440px) 806px, (min-width: 768px) 56vw, calc(100vw - 48px)" layout="full-width" /></div>
				<figcaption><span>Flatbed transport</span><span>Crated materials on the trailer</span></figcaption>
			</figure>
			<figure class="work-secondary">
				<div class="work-photo winter-photo"><Image src={winterTruck} alt="Iron Fist Transport truck in the snow" width={800} widths={[400, 600, 800, 1000]} sizes="(min-width: 1440px) 403px, (min-width: 768px) 28vw, calc(100vw - 48px)" layout="full-width" /></div>
				<figcaption><span>Truck / winter</span><span>Our equipment in the snow</span></figcaption>
			</figure>
		</div>
		<div class="materials-heading"><h3>What do you need moved?</h3><a class="home-link" href="#quote">Tell us about your load<HomeIcon name="arrow" /></a></div>
		<ul class="materials-list">
			{materials.map((material) => <li><h4>{material.title}</h4><p>{material.detail}</p></li>)}
		</ul>
		<p class="load-note">We'll confirm load dimensions, weight and handling requirements before arranging transport.</p>
	</div>
</section>

<style lang="less">
	.work-section {
		background: var(--home-paper);
	}

	.work-heading {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 2rem;
		margin-bottom: 3rem;

		> p {
			margin: 0;
			max-width: 24rem;
			color: var(--home-muted);
			font-size: 1rem;
			line-height: 1.75;
		}
	}

	.work-grid {
		display: grid;
		grid-template-columns: minmax(0, 6fr) minmax(0, 1fr) minmax(0, 3fr);
		align-items: start;

		figure {
			margin: 0;
			min-width: 0;
		}

		figcaption {
			display: flex;
			flex-direction: column;
			gap: 0.375rem;
			padding-block: 1rem;
			color: var(--home-muted);
			font-size: 0.75rem;
			line-height: 1.5;

			span:first-child {
				color: var(--home-ink);
				font-family: var(--home-mono);
				font-size: 0.6875rem;
				letter-spacing: 0.06em;
				text-transform: uppercase;
			}
		}
	}

	.work-primary {
		grid-column: 1;
	}

	.work-grid .work-secondary {
		grid-column: 3;
		margin-top: 50px;
	}

	.work-photo {
		overflow: hidden;

		img {
			display: block;
			width: 100%;
			height: 100%;
			object-fit: cover;
		}
	}

	.truck-photo {
		aspect-ratio: 1.5;

		img {
			object-position: 40% center;
		}
	}

	.winter-photo {
		aspect-ratio: 0.75;

		img {
			object-position: center;
		}
	}

	.materials-heading {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.25rem;
		margin-top: clamp(2rem, 4vw, 4rem);
		padding-block: 1.5rem;

		h3 {
			margin: 0;
			color: var(--home-ink);
			font-size: clamp(1.5rem, 2.4vw, 2rem);
			font-weight: 500;
			letter-spacing: -0.03em;
		}

		.home-link {
			min-height: 2.75rem;
			font-size: 0.875rem;
		}
	}

	.materials-list {
		margin: 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--home-line);

		li {
			display: grid;
			grid-template-columns: 1fr 1.1fr;
			align-items: baseline;
			gap: 1.5rem;
			padding-block: 1.25rem;
			border-bottom: 1px solid var(--home-line);
		}

		h4 {
			margin: 0;
			color: var(--home-ink);
			font-size: clamp(1rem, 1.6vw, 1.375rem);
			font-weight: 500;
			letter-spacing: -0.01em;
			text-transform: uppercase;
		}

		p {
			margin: 0;
			color: var(--home-muted);
			font-size: 0.875rem;
			line-height: 1.6;
		}
	}

	.load-note {
		margin-top: 1.25rem;
		color: var(--home-muted);
		font-size: 0.8125rem;
		line-height: 1.7;
	}

	@media (max-width: 47.99rem) {
		.work-heading {
			align-items: flex-start;
			flex-direction: column;
			gap: 1.25rem;
			margin-bottom: 2rem;
		}

		.work-grid {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}

		.work-primary,
		.work-grid .work-secondary {
			grid-column: 1;
			margin-top: 0;
		}

		.work-grid .work-secondary {
			width: 80%;
			justify-self: end;
		}

		.materials-heading {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.5rem;
		}

		.materials-list li {
			grid-template-columns: 1fr;
			gap: 0.5rem;
		}
	}
</style>

---
import { Image } from "astro:assets";
import truck from "@assets/images/gallery/trucks/tractor.webp";
import loading from "@assets/images/gallery/trucks/moffet-loading-truck.jpg";
import HomeIcon from "./HomeIcon.astro";

const materials = [
	{ title: "Building materials", detail: "Roofing, insulation & site supplies" },
	{ title: "Lumber & wood", detail: "Lumber & packaged wood products" },
	{ title: "Steel & industrial loads", detail: "Pipe, steel & crated freight" },
	{ title: "Palletized supplies", detail: "Packaged materials ready to offload" },
];
---

<section id="work" class="home-section" aria-labelledby="work-title">
	<div class="home-wrap">
		<div class="work-heading">
			<div><p class="home-eyebrow">Our equipment at work</p><h2 id="work-title" class="home-title">A closer look<br />at the work.</h2></div>
			<p>A look at the truck, trailer and forklift we use to move construction materials and industrial loads.</p>
		</div>
		<div class="work-grid">
			<figure>
				<div class="work-photo truck-photo"><Image src={truck} alt="Branded Iron Fist Transport tractor hauling crated materials on a flatbed trailer" width={1000} widths={[480, 768, 1000, 1400]} sizes="(min-width: 1280px) 700px, (min-width: 768px) 56vw, calc(100vw - 48px)" layout="full-width" /></div>
				<figcaption><span>Flatbed transport</span><span>Crated materials on the trailer</span></figcaption>
			</figure>
			<figure>
				<div class="work-photo loading-photo"><Image src={loading} alt="Forklift handling a bundle of steel pipe beside a loaded flatbed trailer in winter" width={800} widths={[400, 600, 800, 1000]} sizes="(min-width: 1280px) 444px, (min-width: 768px) 36vw, calc(100vw - 48px)" layout="full-width" /></div>
				<figcaption><span>Material handling</span><span>Steel pipe at an industrial yard</span></figcaption>
			</figure>
		</div>
		<div class="materials-heading"><h3>What do you need moved?</h3><a class="home-link" href="#quote">Tell us about your load<HomeIcon name="arrow" /></a></div>
		<div class="materials-grid">
			{materials.map((material) => <div class="material"><h4>{material.title}</h4><p>{material.detail}</p></div>)}
		</div>
		<p class="load-note">We'll confirm load dimensions, weight and handling requirements before arranging transport.</p>
	</div>
</section>

<style lang="less">
	.work-heading {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 2rem;
		margin-bottom: 2.75rem;

		> p {
			max-width: 25rem;
			font-size: 0.9375rem;
			line-height: 1.75;
		}
	}

	.work-grid {
		display: grid;
		grid-template-columns: 1.55fr 1fr;
		gap: 1.5rem;

		figure {
			min-width: 0;
		}

		figcaption {
			display: flex;
			flex-direction: column;
			gap: 0.25rem;
			padding-block: 1rem;
			font-size: 0.8125rem;
			font-weight: 700;

			span + span {
				color: var(--home-muted);
				font-size: 0.6875rem;
				font-weight: 400;
			}
		}
	}

	.work-photo {
		height: clamp(18rem, 30vw, 23rem);
		border-radius: 3px;
		overflow: hidden;

		img {
			width: 100%;
			height: 100%;
			object-fit: cover;
		}
	}

	.truck-photo img {
		object-position: 40% center;
	}

	.loading-photo img {
		object-position: 65% 65%;
	}

	.materials-heading {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.25rem;
		margin-top: 2rem;
		padding-block: 1.25rem;
		border-top: 1px solid var(--home-line);

		h3 {
			font-size: 1.125rem;
			font-weight: 700;
			letter-spacing: -0.02em;
		}

		.home-link {
			font-size: 0.75rem;
		}
	}

	.materials-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1.5rem;
	}

	.material {
		padding-left: 1rem;
		border-left: 2px solid #b3c6a7;

		h4 {
			margin-bottom: 0.375rem;
			font-size: 0.8125rem;
		}

		p {
			font-size: 0.6875rem;
			line-height: 1.6;
		}
	}

	.load-note {
		margin-top: 1.5rem;
		font-size: 0.6875rem;
	}

	@media (max-width: 47.99rem) {
		.work-heading {
			align-items: flex-start;
			flex-direction: column;
			gap: 1.25rem;
		}

		.work-grid {
			grid-template-columns: 1fr;
			gap: 1.25rem;
		}

		.work-photo {
			height: auto;
			aspect-ratio: 1.4;
		}

		.materials-heading {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.375rem;
		}

		.materials-grid {
			grid-template-columns: 1fr 1fr;
			gap: 1.5rem 1rem;
		}
	}
</style>

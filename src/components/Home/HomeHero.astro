---
import { Image } from "astro:assets";
import { BUSINESS } from "@data/client";
import hero from "@assets/images/gallery/trucks/tractor.webp";
import HomeIcon from "./HomeIcon.astro";
import ServiceIcon from "./ServiceIcon.astro";
---

<section class="home-hero" aria-labelledby="hero-title" data-home-hero data-contact-intro>
	<figure class="hero-photo">
		<Image src={hero} alt="Iron Fist Transport truck hauling crated materials on a flatbed trailer outside an industrial building" width={1600} widths={[480, 768, 1200, 1600, 2000, 2356]} sizes="100vw" layout="full-width" priority />
	</figure>
	<div class="home-wrap hero-inner">
		<div class="hero-meta"><p>Construction & industrial logistics</p><p>Edmonton-based / Owner-operated</p></div>
		<h1 id="hero-title"><span>MOFFETT delivery</span><span>& flatbed transport</span><span class="hero-local">in Edmonton.</span></h1>
		<div class="hero-bottom">
			<p class="hero-description">Construction materials and industrial loads moved to your jobsite. Truck-mounted forklift offloading when you need it.</p>
			<div class="hero-actions">
				<a class="home-button" href="#quote">Get a quote<HomeIcon name="arrow" /></a>
				<a class="hero-call" href={`tel:${BUSINESS.phoneForTel}`} aria-label={`Call Iron Fist Transport at ${BUSINESS.phoneFormatted}`}><HomeIcon name="phone" />Call us</a>
			</div>
		</div>
	</div>
</section>

<nav class="capability-strip" aria-label="Transport services">
	<div class="home-wrap capabilities">
		<a class="capability" href="/services/moffett-delivery/"><ServiceIcon name="moffett" /><span>MOFFETT<br />delivery</span></a>
		<a class="capability" href="/services/flatbed-transportation/"><ServiceIcon name="flatbed" /><span>Flatbed<br />transport</span></a>
		<a class="capability" href="/services/power-only-trucking/"><ServiceIcon name="tractor" /><span>Power-only<br />trucking</span></a>
		<a class="capability-all" href="/services/">Explore our services<HomeIcon name="arrow" /></a>
	</div>
</nav>

<script src="../../js/home-motion.ts"></script>

<style lang="less">
	.home-hero {
		position: relative;
		isolation: isolate;
		background: #10271d;
		color: #fff;

		&::before {
			content: "";
			position: absolute;
			inset: 0;
			z-index: -1;
			background: #0e291eb8;
		}
	}

	.hero-photo {
		position: absolute;
		inset: 0;
		z-index: -2;
		overflow: hidden;

		img {
			width: 100%;
			height: 100%;
			max-width: none;
			object-fit: cover;
			object-position: center 58%;
		}
	}

	.home-hero[data-motion-active] {
		h1 {
			transform: translate3d(0, var(--hero-heading-lag, 0px), 0);
		}

		.hero-bottom {
			transform: translate3d(0, var(--hero-row-lag, 0px), 0);
		}

		.hero-photo img {
			transform: translate3d(0, var(--hero-photo-lag, 0px), 0);
		}
	}

	.hero-inner {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		min-height: min(42rem, calc(100svh - 8.75rem));
		padding-block: 2rem 2.5rem;
	}

	.hero-meta {
		display: flex;
		justify-content: space-between;
		gap: 1.5rem;

		p {
			color: #f2f5ed;
			font-family: var(--home-mono);
			font-size: clamp(0.875rem, 1.1vw, 1rem);
			line-height: 1.5;
			letter-spacing: 0.075em;
			text-transform: uppercase;
		}
	}

	h1 {
		margin-block: 3rem;
		color: #fff;
		font-size: clamp(3.5rem, 6.7vw, 5.5rem);
		font-weight: 600;
		line-height: 1.01;
		letter-spacing: -0.04em;
		text-transform: uppercase;
		text-wrap: initial;

		span {
			display: block;
		}

		.hero-local {
			color: #d5e7c4;
		}
	}

	.hero-bottom {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 2rem;
		padding-top: 1.5rem;
		border-top: 1px solid #ffffff66;
	}

	.hero-description {
		max-width: 29rem;
		color: #f1f5ec;
		font-size: 1rem;
		line-height: 1.7;
	}

	.hero-actions {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.875rem;
		flex: none;

		.home-button {
			border-color: var(--home-green);
			background: var(--home-green);
			color: #fff;
			font-size: 1rem;

			&:hover {
				border-color: var(--home-forest);
				background: var(--home-forest);
			}
		}
	}

	.hero-call {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		justify-content: center;
		min-height: 3.25rem;
		padding: 0.875rem 1.25rem;
		border: 1px solid #ffffffb3;
		color: #fff;
		font-size: 1rem;
		font-weight: 500;
		line-height: 1.4;
		text-decoration: none;
		transition: background-color 150ms, border-color 150ms;

		&:hover {
			border-color: #fff;
			background: #ffffff14;
		}

		svg {
			width: 1.25rem;
			height: 1.25rem;
			flex: none;
		}
	}

	.capability-strip {
		border-bottom: 1px solid var(--home-line);
		background: var(--home-paper);
	}

	.capabilities {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr)) auto;
		align-items: center;
		min-height: 7rem;
		padding-block: 1rem;

		a {
			display: inline-flex;
			align-items: center;
			gap: 0.875rem;
			min-height: 3.5rem;
			color: var(--home-forest);
			text-decoration: none;

			&:hover span {
				text-decoration: underline;
				text-underline-offset: 0.25em;
			}
		}
	}

	.capability {
		padding-inline: 1.5rem;
		font-size: 0.875rem;
		font-weight: 600;
		line-height: 1.4;
		letter-spacing: 0.03em;
		text-transform: uppercase;

		&:first-child { padding-left: 0; }
		+ .capability { border-left: 1px solid var(--home-line); }
		svg { width: 4rem; height: 2.5rem; flex: none; }
	}

	.capability-all {
		padding-left: 1.5rem;
		font-size: 0.875rem;
		text-decoration: underline !important;
		text-underline-offset: 0.25em;
		svg { width: 1rem; height: 1rem; flex: none; }
	}

	@media (min-width: 64rem) and (min-height: 48rem) {
		.hero-inner {
			padding-bottom: 5.5rem;
		}
	}

	@media (min-width: 64rem) and (max-height: 45rem) {
		h1 {
			margin-block: 2rem;
			font-size: clamp(3rem, 5.5vw, 4.5rem);
		}
	}

	@media (max-width: 63.99rem) {
		.hero-inner {
			min-height: 40rem;
		}

		h1 {
			font-size: clamp(2.5rem, 6.8vw, 4.5rem);
		}

		.hero-bottom {
			align-items: flex-start;
			flex-direction: column;
			gap: 1.25rem;
		}

		.capabilities {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		.capabilities .capability-all {
			display: none;
		}
	}

	@media (max-width: 47.99rem) {
		.hero-inner {
			min-height: 36rem;
			padding-block: 1.75rem 2rem;
		}

		.hero-meta p:last-child {
			display: none;
		}

		h1 {
			margin-block: 2.5rem;
			font-size: clamp(1.875rem, 8.8vw, 3.5rem);
			line-height: 1.07;
			letter-spacing: -0.04em;
		}

		.hero-photo img {
			object-position: 35% center;
		}

		.hero-bottom {
			padding-top: 1.25rem;
		}

		.hero-description {
			font-size: 1rem;
		}

		.hero-actions {
			display: grid;
			grid-template-columns: 1.25fr 1fr;
			width: 100%;
			gap: 0.75rem;

			.home-button { gap: 0.75rem; padding-inline: 0.75rem; }
		}

		.hero-call {
			padding-inline: 0.75rem;
			gap: 0.5rem;
		}

		.capabilities {
			padding-inline: 1rem;
			padding-block: 1.25rem;
			gap: 0;
			min-height: 7.5rem;
		}

		.capabilities .capability {
			flex-direction: column;
			justify-content: center;
			gap: 0.375rem;
			padding-inline: 0.5rem;
			font-size: clamp(0.6875rem, 2.8vw, 0.8125rem);
			text-align: center;
			letter-spacing: 0.02em;
			svg { width: 3.5rem; height: 2.25rem; }
		}
	}
</style>

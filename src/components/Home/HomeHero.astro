---
import { Image } from "astro:assets";
import { BUSINESS } from "@data/client";
import hero from "@assets/images/gallery/trucks/moffetiandtruck.webp";
import HomeIcon from "./HomeIcon.astro";
---

<section class="home-hero" aria-labelledby="hero-title">
	<div class="hero-inner">
		<div class="hero-copy">
			<p class="home-eyebrow">Construction & industrial transport</p>
			<h1 id="hero-title">MOFFETT delivery & flatbed transport <span>in Edmonton.</span></h1>
			<p class="hero-description">Construction materials and industrial loads delivered to your jobsite, with truck-mounted forklift offloading when you need it.</p>
			<div class="hero-actions">
				<a class="home-button" href="#quote">Request a quote<HomeIcon name="arrow" /></a>
				<a class="hero-call" href={`tel:${BUSINESS.phoneForTel}`}><HomeIcon name="phone" /><span>Call {BUSINESS.phoneFormatted}</span></a>
			</div>
			<p class="hero-location"><HomeIcon name="pin" />Edmonton-based. Let's talk about your next delivery.</p>
		</div>
		<figure class="hero-photo">
			<Image src={hero} alt="Red truck-mounted MOFFETT forklift on the back of a flatbed trailer in an equipment yard" width={1200} widths={[480, 768, 1000, 1200, 1636]} sizes="(min-width: 1440px) 792px, (min-width: 1024px) 55vw, 100vw" layout="full-width" priority />
			<figcaption><span>Our equipment. Your jobsite.</span><span class="photo-detail">MOFFETT-equipped flatbed</span></figcaption>
		</figure>
	</div>
</section>

<div class="capability-strip" aria-label="Transport capabilities">
	<div class="home-wrap capabilities">
		<p><HomeIcon name="check" />Truck-mounted offloading</p>
		<p><HomeIcon name="check" />Flatbed transportation</p>
		<p><HomeIcon name="check" />Power-only trucking</p>
		<p><HomeIcon name="check" />Owner-operated service</p>
	</div>
</div>

<style lang="less">
	.home-hero {
		background: var(--home-forest);
	}

	.hero-inner {
		display: grid;
		grid-template-columns: 45fr 55fr;
		max-width: 90rem;
		margin-inline: auto;
		min-height: 35.5rem;
	}

	.hero-copy {
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: 3.5rem clamp(2rem, 4vw, 4rem);

		.home-eyebrow {
			color: #c1d8b4;
			font-size: 0.625rem;
		}

		h1 {
			max-width: 35rem;
			color: #fff;
			font-size: clamp(2.75rem, 4.1vw, 3.875rem);
			font-weight: 900;
			line-height: 1.05;
			letter-spacing: -0.04em;
			text-wrap: initial;

			span {
				color: #c1d8b4;
			}
		}
	}

	.hero-description {
		max-width: 29rem;
		margin-top: 1.625rem;
		color: #d3dfd5;
		font-size: 0.9375rem;
		line-height: 1.75;
	}

	.hero-actions {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 1rem 1.5rem;
		margin-top: 2rem;
	}

	.hero-call {
		display: inline-flex;
		align-items: center;
		gap: 0.625rem;
		min-height: 3.25rem;
		color: #fff;
		font-size: 0.8125rem;
		font-weight: 700;
		text-decoration: none;

		&:hover {
			text-decoration: underline;
			text-underline-offset: 0.25em;
		}

		svg {
			width: 1rem;
			height: 1rem;
		}
	}

	.hero-location {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-top: 2.5rem;
		color: #b9cabb;
		font-size: 0.6875rem;

		svg {
			width: 0.875rem;
			height: 0.875rem;
			flex: none;
		}
	}

	.hero-photo {
		position: relative;
		min-width: 0;
		min-height: 100%;

		img {
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			max-width: none;
			object-fit: cover;
			object-position: 63% center;
		}

		figcaption {
			position: absolute;
			bottom: 1.5rem;
			left: 1.5rem;
			right: 1.5rem;
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 1rem;
			padding: 1rem 1.125rem;
			border-left: 3px solid #c1d8b4;
			background: #123b2af2;
			color: #fff;
			font-size: 0.75rem;
			font-weight: 700;
		}

		.photo-detail {
			color: #cbd9ce;
			font-size: 0.625rem;
			font-weight: 400;
		}
	}

	.capability-strip {
		border-bottom: 1px solid var(--home-line);
		background: var(--home-paper);
	}

	.capabilities {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		padding-block: 1.5rem;

		p {
			display: flex;
			align-items: center;
			justify-content: center;
			gap: 0.625rem;
			padding-inline: 1rem;
			border-right: 1px solid #d2ddcc;
			color: var(--home-forest);
			font-size: 0.75rem;
			font-weight: 700;

			&:first-child {
				justify-content: flex-start;
				padding-left: 0;
			}

			&:last-child {
				padding-right: 0;
				border: 0;
			}
		}

		svg {
			width: 1.125rem;
			height: 1.125rem;
			color: var(--home-green);
			flex: none;
		}
	}

	@media (max-width: 63.99rem) {
		.hero-inner {
			grid-template-columns: 1fr;
		}

		.hero-copy {
			padding: 3.5rem clamp(1.5rem, 6vw, 4rem);

			h1 {
				max-width: 41rem;
				font-size: clamp(2.75rem, 6.5vw, 3.875rem);
			}
		}

		.hero-photo {
			min-height: 24rem;

			img {
				object-position: center;
			}
		}

		.capabilities {
			grid-template-columns: 1fr 1fr;
			gap: 1rem;

			p,
			p:first-child {
				justify-content: flex-start;
				padding: 0;
				border: 0;
			}
		}
	}

	@media (max-width: 47.99rem) {
		.hero-copy {
			padding-block: 2rem;

			h1 {
				font-size: clamp(2.5rem, 9.5vw, 3.25rem);
			}
		}

		.hero-description {
			margin-top: 1.25rem;
			font-size: 0.875rem;
		}

		.hero-actions {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.5rem;
			margin-top: 1.5rem;
		}

		.hero-call {
			min-height: 2.75rem;
		}

		.hero-location {
			display: none;
		}

		.hero-photo {
			min-height: 13rem;

			figcaption {
				bottom: 1rem;
				left: 1rem;
				right: 1rem;
				font-size: 0.6875rem;
			}

			.photo-detail {
				display: none;
			}
		}

		.capabilities {
			gap: 1rem 0.75rem;

			p {
				font-size: 0.625rem;
			}
		}
	}
</style>

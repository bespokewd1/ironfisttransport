---
import { Image } from "astro:assets";
import { BUSINESS } from "@data/client";
import hero from "@assets/images/gallery/trucks/tractor.webp";
import HomeIcon from "./HomeIcon.astro";
---

<section class="home-hero" aria-labelledby="hero-title">
	<figure class="hero-photo">
		<Image src={hero} alt="Iron Fist Transport truck hauling crated materials on a flatbed trailer outside an industrial building" width={1600} widths={[480, 768, 1200, 1600, 2000, 2356]} sizes="100vw" layout="full-width" priority />
	</figure>
	<div class="home-wrap hero-inner">
		<div class="hero-meta"><p>Construction & industrial logistics</p><p>Edmonton-based / Owner-operated</p></div>
		<h1 id="hero-title"><span>MOFFETT delivery</span><span>& flatbed transport</span><span class="hero-local">in Edmonton.</span></h1>
		<div class="hero-bottom">
			<p class="hero-description">Construction materials and industrial loads moved to your jobsite. Truck-mounted forklift offloading when you need it.</p>
			<div class="hero-actions">
				<a class="home-button" href="#quote">Request a quote<HomeIcon name="arrow" /></a>
				<a class="hero-call" href={`tel:${BUSINESS.phoneForTel}`}><HomeIcon name="phone" />{BUSINESS.phoneFormatted}</a>
			</div>
		</div>
	</div>
</section>

<div class="capability-strip" aria-label="Transport services">
	<div class="home-wrap capabilities"><span>MOFFETT delivery</span><span>Flatbed transport</span><span>Power-only trucking</span><a href="/services/">Explore our services<HomeIcon name="arrow" /></a></div>
</div>

<style lang="less">
	.home-hero {
		position: relative;
		isolation: isolate;
		background: #10271d;
		color: #fff;

		&::before {
			content: "";
			position: absolute;
			inset: 0;
			z-index: -1;
			background: #0e291e9c;
		}
	}

	.hero-photo {
		position: absolute;
		inset: 0;
		z-index: -2;
		overflow: hidden;

		img {
			width: 100%;
			height: 100%;
			max-width: none;
			object-fit: cover;
			object-position: center 58%;
		}
	}

	.hero-inner {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		min-height: min(42rem, calc(100svh - 8.75rem));
		padding-block: 2rem 2.5rem;
	}

	.hero-meta {
		display: flex;
		justify-content: space-between;
		gap: 1.5rem;

		p {
			color: #f2f5ed;
			font-family: var(--home-mono);
			font-size: 0.625rem;
			line-height: 1.5;
			letter-spacing: 0.075em;
			text-transform: uppercase;
		}
	}

	h1 {
		margin-block: 3rem;
		color: #fff;
		font-size: clamp(3.5rem, 6.7vw, 5.5rem);
		font-weight: 500;
		line-height: 1.01;
		letter-spacing: -0.06em;
		text-transform: uppercase;
		text-wrap: initial;

		span {
			display: block;
		}

		.hero-local {
			color: #d5e7c4;
		}
	}

	.hero-bottom {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 2rem;
		padding-top: 1.5rem;
		border-top: 1px solid #ffffff66;
	}

	.hero-description {
		max-width: 29rem;
		color: #f1f5ec;
		font-size: 0.875rem;
		line-height: 1.7;
	}

	.hero-actions {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 1rem 2rem;
		flex: none;

		.home-button {
			border-color: #e8eee3;
			background: #e8eee3;
			color: var(--home-forest);

			&:hover {
				border-color: #fff;
				background: #fff;
			}
		}
	}

	.hero-call {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		min-height: 3.25rem;
		color: #fff;
		font-family: var(--home-mono);
		font-size: 0.75rem;
		text-decoration: none;

		&:hover {
			text-decoration: underline;
			text-underline-offset: 0.3em;
		}

		svg {
			width: 1rem;
			height: 1rem;
		}
	}

	.capability-strip {
		border-bottom: 1px solid var(--home-line);
		background: var(--home-paper);
	}

	.capabilities {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		min-height: 3.25rem;
		padding-block: 0.5rem;
		font-family: var(--home-mono);
		font-size: 0.625rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;

		a {
			display: inline-flex;
			align-items: center;
			gap: 1rem;
			min-height: 2.25rem;
			color: var(--home-forest);
			font-size: inherit;
			text-decoration: none;

			svg {
				width: 1rem;
				height: 1rem;
			}
		}
	}

	@media (min-width: 64rem) and (max-height: 45rem) {
		h1 {
			margin-block: 2rem;
			font-size: clamp(3rem, 5.5vw, 4.5rem);
		}
	}

	@media (max-width: 63.99rem) {
		.hero-inner {
			min-height: 40rem;
		}

		h1 {
			font-size: clamp(2.5rem, 6.8vw, 4.5rem);
		}

		.hero-bottom {
			align-items: flex-start;
			flex-direction: column;
			gap: 1.25rem;
		}

		.capabilities > a {
			display: none;
		}
	}

	@media (max-width: 47.99rem) {
		.hero-inner {
			min-height: 36rem;
			padding-block: 1.75rem 2rem;
		}

		.hero-meta p:last-child {
			display: none;
		}

		h1 {
			margin-block: 2.75rem 4.5rem;
			font-size: clamp(1.875rem, 8.8vw, 3.5rem);
			line-height: 1.07;
			letter-spacing: -0.055em;
		}

		.hero-photo img {
			object-position: 35% center;
		}

		.hero-bottom {
			padding-top: 1.25rem;
		}

		.hero-description {
			font-size: 0.8125rem;
		}

		.hero-actions {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.25rem;
		}

		.hero-call {
			min-height: 2.75rem;
		}

		.capabilities {
			gap: 0.75rem;
			font-size: 0.5rem;
			letter-spacing: 0;
		}
	}
</style>

---
import { Image } from "astro:assets";
import moffett from "@assets/images/gallery/trucks/moffetiandtruck.webp";
import flatbed from "@assets/images/gallery/trucks/moffet-loading-truck.jpg";
import tractor from "@assets/images/gallery/trucks/tractor.webp";
import HomeIcon from "./HomeIcon.astro";

const services = [
	{ number: "01", title: "MOFFETT delivery", image: moffett, alt: "Truck-mounted MOFFETT forklift attached to a flatbed trailer", description: "Material delivery with a forklift on board. We can offload suitable palletized loads at the destination without a separate site forklift.", detail: "Delivery + offloading", href: "#moffett", link: "How MOFFETT delivery works", position: "70% center" },
	{ number: "02", title: "Flatbed transportation", image: flatbed, alt: "Steel pipe on a flatbed trailer beside a forklift in a snowy industrial yard", description: "Open-deck transport for construction materials and industrial loads. Tell us what you're moving so we can discuss the right setup.", detail: "Construction + industrial loads", href: "#quote", link: "Discuss your flatbed load", position: "center 65%" },
	{ number: "03", title: "Power-only trucking", image: tractor, alt: "Iron Fist Transport tractor connected to a loaded trailer outside an industrial building", description: "Have the trailer but need the truck? Arrange a tractor and driver to move your roadworthy trailer between pickup and delivery locations.", detail: "Your trailer. Our tractor.", href: "#quote", link: "Plan a power-only move", position: "25% center" },
];
---

<section id="services" class="home-section" aria-labelledby="services-title">
	<div class="home-wrap">
		<div class="section-heading">
			<div>
				<p class="home-eyebrow">Our services</p>
				<h2 id="services-title" class="home-title">The right setup<br />for your load.</h2>
			</div>
			<p>From the supplier's yard to your jobsite, we help contractors and industrial businesses move the materials their work depends on.</p>
		</div>
		<div class="services-grid">
			{services.map((service) => (
				<article class="service">
					<div class="service-photo">
						<Image src={service.image} alt={service.alt} width={680} widths={[360, 480, 680, 960]} sizes="(min-width: 1280px) 379px, (min-width: 768px) 30vw, calc(100vw - 48px)" layout="full-width" style={`object-position: ${service.position}`} />
						<span class="service-number" aria-hidden="true">{service.number}</span>
					</div>
					<div class="service-body">
						<p class="service-detail">{service.detail}</p>
						<h3>{service.title}</h3>
						<p class="service-description">{service.description}</p>
						<a class="home-link" href={service.href}>{service.link}<HomeIcon name="arrow" /></a>
					</div>
				</article>
			))}
		</div>
	</div>
</section>

<style lang="less">
	.section-heading {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 2rem;
		margin-bottom: 2.75rem;

		> p {
			max-width: 26rem;
			padding-bottom: 0.25rem;
			font-size: 0.9375rem;
			line-height: 1.75;
		}
	}

	.services-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.5rem;
	}

	.service {
		display: flex;
		flex-direction: column;
		min-width: 0;
		border-bottom: 1px solid var(--home-line);
	}

	.service-photo {
		position: relative;
		aspect-ratio: 1.6;
		overflow: hidden;
		border-radius: 3px;

		img {
			width: 100%;
			height: 100%;
			object-fit: cover;
		}
	}

	.service-number {
		position: absolute;
		top: 0.875rem;
		left: 0.875rem;
		display: grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 2px;
		background: var(--home-forest);
		color: #fff;
		font-size: 0.6875rem;
		font-weight: 700;
	}

	.service-body {
		display: flex;
		flex: 1;
		flex-direction: column;
		align-items: flex-start;
		padding-block: 1.5rem 1rem;

		h3 {
			margin-bottom: 0.875rem;
			font-size: 1.375rem;
			font-weight: 900;
			line-height: 1.2;
			letter-spacing: -0.025em;
		}

		.home-link {
			margin-top: auto;
			font-size: 0.75rem;
		}
	}

	.service-detail {
		margin-bottom: 0.625rem;
		color: var(--home-green);
		font-size: 0.625rem;
		font-weight: 700;
		letter-spacing: 0.07em;
		text-transform: uppercase;
	}

	.service-description {
		margin-bottom: 1.25rem;
		font-size: 0.875rem;
		line-height: 1.75;
	}

	@media (max-width: 47.99rem) {
		.section-heading {
			align-items: flex-start;
			flex-direction: column;
			gap: 1.25rem;
		}

		.services-grid {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}

		.service-photo {
			aspect-ratio: 1.55;
		}
	}
</style>

---
import { Image } from "astro:assets";
import moffett from "@assets/images/gallery/trucks/moffetiandtruck.webp";
import flatbed from "@assets/images/gallery/trucks/moffet-loading-truck.jpg";
import tractor from "@assets/images/gallery/trucks/tractor.webp";
import HomeIcon from "./HomeIcon.astro";

const services = [
	{ number: "01", title: "MOFFETT delivery", image: moffett, alt: "Truck-mounted MOFFETT forklift attached to a flatbed trailer", description: "Material delivery with a forklift on board. We can offload suitable palletized loads at the destination without a separate site forklift.", detail: "Delivery + offloading", href: "/services/moffett-delivery/", link: "How MOFFETT delivery works", position: "70% center" },
	{ number: "02", title: "Flatbed transportation", image: flatbed, alt: "Steel pipe on a flatbed trailer beside a forklift in a snowy industrial yard", description: "Open-deck transport for construction materials and industrial loads. Share cargo size, weight and the equipment available for loading and unloading.", detail: "Construction + industrial loads", href: "/services/flatbed-transportation/", link: "How flatbed transport works", position: "center 65%" },
	{ number: "03", title: "Power-only trucking", image: tractor, alt: "Iron Fist Transport tractor connected to a loaded trailer outside an industrial building", description: "Have the trailer but need the truck? Arrange a tractor and driver to move your roadworthy trailer between pickup and delivery locations.", detail: "Your trailer. Our tractor.", href: "/services/power-only-trucking/", link: "How power-only trucking works", position: "25% center" },
];
---

<section id="services" class="home-section services-section" aria-labelledby="services-title">
	<div class="home-wrap">
		<div class="section-heading">
			<div><p class="home-eyebrow">Our services / Service index</p><h2 id="services-title" class="home-title">The right setup<br />for your load.</h2></div>
			<p>From the supplier's yard to your jobsite, we help contractors and industrial businesses move the materials their work depends on.</p>
		</div>
		<div class="service-index">
			{services.map((service) => (
				<article class="service">
					<div class="service-body">
						<div class="service-meta"><span aria-hidden="true">{service.number}</span><p>{service.detail}</p></div>
						<h3>{service.title}</h3>
						<p class="service-description">{service.description}</p>
						<a class="home-link" href={service.href}>{service.link}<HomeIcon name="arrow" /></a>
					</div>
					<div class="service-photo"><Image src={service.image} alt={service.alt} width={1000} widths={[400, 600, 800, 1000, 1400]} sizes="(min-width: 1440px) 797px, (min-width: 768px) 55vw, calc(100vw - 48px)" layout="full-width" style={`object-position: ${service.position}`} /></div>
				</article>
			))}
		</div>
	</div>
</section>

<style lang="less">
	.services-section {
		background: #fff;
	}

	.section-heading {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 2rem;
		margin-bottom: 3rem;

		> p {
			max-width: 25rem;
			padding-bottom: 0.25rem;
			color: var(--home-muted);
			font-size: 0.9375rem;
			line-height: 1.75;
		}
	}

	.service {
		display: grid;
		grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
		gap: clamp(2rem, 4vw, 4rem);
		min-width: 0;
		padding-block: 2rem;
		border-top: 1px solid var(--home-line);

		&:last-child {
			padding-bottom: 0;
		}
	}

	.service-body {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		min-width: 0;
		padding-block: 0.5rem;

		h3 {
			max-width: 24rem;
			margin-block: 2rem 1rem;
			color: var(--home-ink);
			font-size: clamp(1.75rem, 3vw, 2.75rem);
			font-weight: 500;
			line-height: 1.1;
			letter-spacing: -0.04em;
		}

		.home-link {
			margin-top: auto;
			padding-top: 1rem;
		}
	}

	.service-meta {
		display: flex;
		align-items: baseline;
		gap: 1.5rem;
		font-family: var(--home-mono);
		font-size: 0.625rem;
		line-height: 1.5;
		letter-spacing: 0.04em;
		text-transform: uppercase;

		span {
			color: var(--home-green);
		}

		p {
			color: var(--home-muted);
			font-size: inherit;
			line-height: inherit;
		}
	}

	.service-description {
		max-width: 24rem;
		margin-bottom: 1rem;
		color: var(--home-muted);
		font-size: 0.875rem;
		line-height: 1.75;
	}

	.service-photo {
		aspect-ratio: 1.9;
		overflow: hidden;

		img {
			display: block;
			width: 100%;
			height: 100%;
			object-fit: cover;
		}
	}

	@media (max-width: 63.99rem) {
		.service {
			grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
		}

		.service-photo {
			aspect-ratio: auto;
			min-height: 21rem;
		}
	}

	@media (max-width: 47.99rem) {
		.section-heading {
			align-items: flex-start;
			flex-direction: column;
			gap: 1.25rem;
			margin-bottom: 2rem;
		}

		.service {
			grid-template-columns: 1fr;
			gap: 1.5rem;
			padding-block: 1.75rem;
		}

		.service-body h3 {
			margin-top: 1.5rem;
			font-size: 2rem;
		}

		.service-photo {
			aspect-ratio: 1.55;
			min-height: 0;
		}
	}
</style>

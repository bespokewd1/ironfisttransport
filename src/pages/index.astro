---
import { SOCIAL_CARDS } from "@data/social";
import BaseLayout from "@layouts/BaseLayout.astro";
import HomeHeader from "@components/Home/HomeHeader.astro";
import HomeHero from "@components/Home/HomeHero.astro";
import HomeServices from "@components/Home/HomeServices.astro";
import HomeMoffett from "@components/Home/HomeMoffett.astro";
import HomeWork from "@components/Home/HomeWork.astro";
import HomeAbout from "@components/Home/HomeAbout.astro";
import HomeQuote from "@components/Home/HomeQuote.astro";
import HomeFooter from "@components/Home/HomeFooter.astro";

const socialCard = SOCIAL_CARDS.home;
---

<BaseLayout
	title="MOFFETT & Flatbed in Edmonton"
	description="Edmonton-based MOFFETT delivery, flatbed transport and power-only trucking for construction and industrial loads. Call the owner-driver to discuss your move."
	socialImage={socialCard.image}
	socialDescription={socialCard.socialDescription}
	preloadHero={false}
	variant="transport"
>
	<HomeHeader slot="header" />
	<HomeHero />
	<HomeServices />
	<HomeMoffett />
	<HomeWork />
	<HomeAbout />
	<HomeQuote />
	<HomeFooter slot="footer" revealAfterHero />
</BaseLayout>

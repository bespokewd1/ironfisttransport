---
import { getImage } from "astro:assets";
import BaseLayout from "@layouts/BaseLayout.astro";
import HomeHeader from "@components/Home/HomeHeader.astro";
import HomeHero from "@components/Home/HomeHero.astro";
import HomeServices from "@components/Home/HomeServices.astro";
import HomeMoffett from "@components/Home/HomeMoffett.astro";
import HomeWork from "@components/Home/HomeWork.astro";
import HomeAbout from "@components/Home/HomeAbout.astro";
import HomeQuote from "@components/Home/HomeQuote.astro";
import HomeFooter from "@components/Home/HomeFooter.astro";
import hero from "@assets/images/gallery/trucks/tractor.webp";

const socialImage = await getImage({ src: hero, width: 1200, height: 630, format: "jpg", fit: "cover" });
---

<BaseLayout
	title="MOFFETT Delivery & Flatbed Transport in Edmonton"
	description="MOFFETT delivery, flatbed transport and power-only trucking in Edmonton. Owner-operated service for construction and industrial loads. Call for a quote."
	heroImage={socialImage}
	preloadHero={false}
	variant="transport"
>
	<HomeHeader slot="header" />
	<HomeHero />
	<HomeServices />
	<HomeMoffett />
	<HomeWork />
	<HomeAbout />
	<HomeQuote />
	<HomeFooter slot="footer" revealAfterHero />
</BaseLayout>

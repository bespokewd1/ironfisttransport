---
import { SOCIAL_CARDS } from "@data/social";
import BaseLayout from "@layouts/BaseLayout.astro";
import HomeHero from "@components/Home/HomeHero.astro";
import HomeServices from "@components/Home/HomeServices.astro";
import HomeIndustries from "@components/Home/HomeIndustries.astro";
import HomeReviews from "@components/Home/HomeReviews.astro";
import HomeMoffett from "@components/Home/HomeMoffett.astro";
import HomeWork from "@components/Home/HomeWork.astro";
import HomeAbout from "@components/Home/HomeAbout.astro";
import HomeBlog from "@components/Home/HomeBlog.astro";
import HomeQuote from "@components/Home/HomeQuote.astro";

const socialCard = SOCIAL_CARDS.home;
---

<BaseLayout
	title="Moffett delivery & flatbed trucking in Edmonton"
	titleSuffix="Iron Fist Transport"
	description="Edmonton-based MOFFETT delivery, flatbed transport and power-only trucking for construction and industrial loads. Call to discuss your route and load."
	socialImage={socialCard.image}
	socialDescription={socialCard.socialDescription}
	preloadHero={false}
	quoteHref="#quote" revealContactAfterIntro
>
	<HomeHero />
	<HomeReviews />
	<HomeServices />
	<HomeIndustries />
	<HomeMoffett />
	<HomeWork />
	<HomeAbout />
	<HomeBlog />
	<HomeQuote />
</BaseLayout>

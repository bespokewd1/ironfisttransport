---
import { render, type CollectionEntry } from "astro:content";
import { getImage } from "astro:assets";
import { SITE } from "@data/client";
import { SOCIAL_CARDS } from "@data/social";
import { getBlogPostingSchema } from "@js/blogPostingSchema.js";
import BaseLayout from "@layouts/BaseLayout.astro";
import BlogHero from "@components/Blog/BlogHero.astro";
import BlogContact from "@components/Blog/BlogContact.astro";
import "@styles/blog.less";
interface Props { post: CollectionEntry<"blog"> }
const { post } = Astro.props;
const { Content, headings } = await render(post);
const { title, seoTitle, description, image, imageAlt, author, date } = post.data;
// Branded cards are authored per article; future posts retain their cover-image fallback.
const socialCardsByPost = { "moffett-delivery-without-site-forklift": SOCIAL_CARDS["blog-moffett-delivery"] };
const socialCard = socialCardsByPost[post.id as keyof typeof socialCardsByPost];
const schemaImage = await getImage({src:image, width:1200, height:630, format:"jpeg", fit:"cover"});
const blogPostingSchema = getBlogPostingSchema({title, description, url:new URL(Astro.url.pathname,SITE.url).href, imageUrl:new URL(schemaImage.src,SITE.url).href, imageAlt, publishedTime:date.toISOString(), author, authorType:"Organization"}, new URL(SITE.url).origin);
---
<BaseLayout title={seoTitle || title} description={description} heroImage={image} socialImage={socialCard?.image} socialDescription={socialCard?.socialDescription} preloadHero={false} revealContactAfterIntro>
  <script slot="schema" is:inline type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />
  <article>
    <BlogHero post={post} />
    <div class="article-reading"><div class="home-wrap article-grid">
      <nav class="article-contents" aria-label="Article contents"><h2>In this guide</h2><ol>{headings.filter(h => h.depth === 2).map(h => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></nav>
      <div class="article-prose" id="article-content"><Content /></div>
    </div></div>
  </article>
  <BlogContact />
</BaseLayout>
<script src="../js/article-contents.ts"></script>
<script>
  function setupCopy() {
    const template = document.querySelector<HTMLElement>(".article-prose pre");
    if (!template || template.nextElementSibling?.classList.contains("enquiry-copy")) return;
    const controls = document.createElement("div");
    controls.className = "enquiry-copy";
    const button = document.createElement("button");
    button.type = "button";
    button.className = "home-button home-button--outline";
    button.textContent = "Copy enquiry template";
    const status = document.createElement("span");
    status.className = "copy-status";
    status.setAttribute("role", "status");
    button.addEventListener("click", async () => {
      try { await navigator.clipboard.writeText(template.textContent ?? ""); status.textContent = "Template copied. Paste it into your email."; }
      catch { status.textContent = "Select the template above and copy it into your email."; }
    });
    controls.append(button, status);
    template.after(controls);
  }
  document.addEventListener("astro:page-load", setupCopy);
</script>

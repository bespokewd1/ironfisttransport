---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { SocialImage } from "@data/social";
import BaseLayout from "@layouts/BaseLayout.astro";
import HomeHeader from "@components/Home/HomeHeader.astro";
import HomeFooter from "@components/Home/HomeFooter.astro";
import HomeQuote from "@components/Home/HomeQuote.astro";
import "@styles/services.less";

interface Props {
	title: string;
	description: string;
	image: ImageMetadata;
	socialImage?: SocialImage;
	socialDescription?: string;
	quoteService?: "MOFFETT delivery" | "Flatbed transportation" | "Power-only trucking" | "";
	quoteChecklist?: string[];
}

const { title, description, image, socialImage, socialDescription, quoteService = "", quoteChecklist } = Astro.props;
const heroImage = socialImage ? undefined : await getImage({ src: image, width: 1200, height: 630, format: "jpg", fit: "cover" });
---

<BaseLayout title={title} description={description} heroImage={heroImage} socialImage={socialImage} socialDescription={socialDescription} preloadHero={false} variant="transport">
	<HomeHeader slot="header" />
	<div class="services-page">
		<slot />
	</div>
	<HomeQuote defaultService={quoteService} checklist={quoteChecklist} />
	<HomeFooter slot="footer" revealAfterHero />
</BaseLayout>

---
// Utils
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import type { GetImageResult, ImageMetadata } from "astro";
import "@styles/root.less";
import "@styles/home.less";

// Components
import Header from "@components/Header/Header.astro";
import Footer from "@components/Footer/Footer.astro";
import Meta from "@components/Meta/Meta.astro";

// Data
import { SITE } from "@data/client";
import type { SocialImage } from "@data/social";

// Create a union type for heroImage
type HeroImage = GetImageResult | ImageMetadata;

interface Props {
	title: string;
	titleSuffix?: string;
	description: string;
	heroImage?: HeroImage; // Used for legacy social metadata and, optionally, image preloading.
	socialImage?: SocialImage;
	socialDescription?: string;
	preloadHero?: boolean;
	revealContactAfterIntro?: boolean;
	quoteHref?: string;
}

const {
	description,
	title,
	titleSuffix,
	heroImage,
	socialImage,
	socialDescription,
	preloadHero = true,
	revealContactAfterIntro = false,
	quoteHref = "/#quote",
} = Astro.props as Props;
---

<html lang={SITE.locale}>
	<head>
		<meta charset="utf-8" />
		<!-- View Transitions support -->
		<ClientRouter />

		<!-- SEO Meta Tags -->
		<Meta title={title} titleSuffix={titleSuffix} description={description} heroImage={heroImage} socialImage={socialImage} socialDescription={socialDescription}>
			<slot name="schema" slot="schema" />
		</Meta>

		<!-- Astro custom Font API -->
		<Font cssVariable="--font-primary" />
		<Font cssVariable="--font-transport" />

		<!-- If present, preloads the image passed as a prop -->
		{heroImage && preloadHero && <link rel="preload" href={heroImage.src} as="image" />}
	</head>
	<body class="transport-home">
		<!-- Screen reader skip main nav -->
		<a class="skip" aria-label="skip to main content" href="#main"
			>Click To Skip To Main Content</a
		>

		<Header quoteHref={quoteHref} />
		<main id="main" tabindex="-1">
			<slot />
		</main>
		<Footer quoteHref={quoteHref} revealAfterHero={revealContactAfterIntro} />
	</body>
</html>

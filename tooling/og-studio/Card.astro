---
import { BUSINESS } from "@data/client";
import type { SOCIAL_CARDS } from "@data/social";
import type { ImageMetadata } from "astro";

interface Props {
	slug: keyof typeof SOCIAL_CARDS;
	card: (typeof SOCIAL_CARDS)[keyof typeof SOCIAL_CARDS];
	photo: ImageMetadata;
	photoAlt: string;
	photoPosition: string;
	logo: ImageMetadata;
	headlineSize: number;
}

const { slug, card, photo, photoAlt, photoPosition, logo, headlineSize } = Astro.props;
---

<article
	class="og-card"
	data-og-card={slug}
	data-route={card.route}
	data-image-alt={card.image.alt}
	aria-labelledby={`${slug}-headline`}
	style={`--headline-size: ${headlineSize}px; --photo-position: ${photoPosition};`}
>
	<div class="og-copy">
		<div class="og-logo-panel">
			<img
				src={logo.src}
				width={logo.width}
				height={logo.height}
				alt={BUSINESS.name}
				loading="eager"
				decoding="sync"
			/>
		</div>
		<div class="og-message">
			<h3 id={`${slug}-headline`}>{card.headline}</h3>
			<p>{card.supporting}</p>
		</div>
	</div>
	<div class="og-photo">
		<img
			src={photo.src}
			width={photo.width}
			height={photo.height}
			alt={photoAlt}
			loading="eager"
			decoding="sync"
		/>
	</div>
	<footer class="og-contact">
		<span class="og-call">Call {BUSINESS.owner}</span>
		<span class="og-phone">{BUSINESS.phoneFormatted}</span>
		<span class="og-location">{BUSINESS.address.city}, Alberta</span>
	</footer>
</article>

<style>
	.og-card,
	.og-card * {
		box-sizing: border-box;
	}

	.og-card {
		display: grid;
		grid-template-columns: 480px 720px;
		grid-template-rows: 546px 84px;
		width: 1200px;
		height: 630px;
		margin: 0;
		background: #153e2d;
		color: #fff;
		font-family: var(--font-transport), Inter, Arial, sans-serif;
		font-synthesis: none;
		isolation: isolate;
	}

	.og-copy {
		display: flex;
		flex-direction: column;
		padding: 40px 48px 36px;
		min-width: 0;
	}

	.og-logo-panel {
		display: grid;
		place-items: center;
		flex: 0 0 auto;
		width: 300px;
		height: 116px;
		padding: 16px 20px;
		background: #e8eee3;
	}

	.og-logo-panel img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.og-message {
		margin-top: auto;
		padding-top: 28px;
	}

	.og-message h3 {
		margin: 0;
		font-size: var(--headline-size);
		font-weight: 600;
		line-height: 1.06;
		letter-spacing: -0.035em;
		text-wrap: balance;
	}

	.og-message p {
		margin: 20px 0 0;
		color: #e8eee3;
		font-size: 22px;
		font-weight: 400;
		line-height: 1.4;
	}

	.og-photo {
		min-width: 0;
		min-height: 0;
		background: #326e3b;
	}

	.og-photo img {
		display: block;
		width: 720px;
		height: 546px;
		object-fit: cover;
		object-position: var(--photo-position);
	}

	.og-contact {
		grid-column: 1 / -1;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 32px;
		padding: 0 48px;
		background: #e8eee3;
		color: #153e2d;
		border-top: 1px solid #bbcbbb;
		white-space: nowrap;
	}

	.og-call {
		font-size: 25px;
		font-weight: 600;
		letter-spacing: -0.025em;
	}

	.og-phone {
		font-size: 31px;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
		letter-spacing: -0.025em;
	}

	.og-location {
		font-family: "Courier New", ui-monospace, monospace;
		font-size: 19px;
		line-height: 1.4;
	}
</style>
